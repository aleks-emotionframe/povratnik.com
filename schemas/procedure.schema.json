{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leben-in-kroatien.example/schemas/procedure.schema.json",
  "title": "Procedure",
  "description": "One administrative procedure with its own identifier. Residence registration, address registration and accommodation reporting are three procedures, never one. docs/datenmodell.md 2.2 and 5.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/lifecycle" }],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "synthetic": true,
    "title": { "$ref": "common.schema.json#/$defs/i18n_text" },
    "term": { "$ref": "common.schema.json#/$defs/term" },
    "authority": {
      "type": "object",
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "$ref": "common.schema.json#/$defs/i18n_text" }
      },
      "required": ["key", "name"],
      "additionalProperties": false
    },
    "legal_basis": {
      "description": "Citation of the governing provision, for example an article of a law in Narodne novine. The source entry carries the URL.",
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/i18n_text" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/i18n_text" }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "sources": true,
    "approval": true,
    "publication": true,
    "validity": true,
    "review": true
  },
  "required": ["id", "version", "title", "term", "authority", "legal_basis", "prerequisites", "steps", "forms"],
  "additionalProperties": false
}
