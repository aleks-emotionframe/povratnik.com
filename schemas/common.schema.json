{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leben-in-kroatien.example/schemas/common.schema.json",
  "title": "Shared building blocks",
  "description": "Building blocks from docs/datenmodell.md sections 1 to 3. Every dataset type composes these.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version_ref": {
      "description": "Reference to a specific version of another dataset: id@version.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "i18n_text": {
      "description": "Multilingual text. German is the source language and required.",
      "type": "object",
      "properties": {
        "de": { "type": "string", "minLength": 1 },
        "hr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "required": ["de"],
      "additionalProperties": false
    },
    "term": {
      "description": "Croatian official term kept in the original, plus an explanation per language. datenmodell.md section 6.",
      "type": "object",
      "properties": {
        "term_hr": { "type": "string", "minLength": 1 },
        "term_explained": { "$ref": "#/$defs/i18n_text" }
      },
      "required": ["term_hr", "term_explained"],
      "additionalProperties": false
    },
    "fact": {
      "description": "A domain value with its four dimensions. value is only allowed when availability is known; unknown never becomes null or false.",
      "type": "object",
      "properties": {
        "value": {},
        "unit": { "type": "string" },
        "availability": { "$ref": "vocabularies.schema.json#/$defs/availability" },
        "evidence": { "$ref": "vocabularies.schema.json#/$defs/evidence" },
        "currency": { "$ref": "vocabularies.schema.json#/$defs/currency" },
        "checked_at": { "$ref": "#/$defs/date" },
        "next_check": { "$ref": "#/$defs/date" },
        "note": { "$ref": "#/$defs/i18n_text" }
      },
      "required": ["availability", "evidence", "currency", "checked_at"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "known" } } },
          "then": { "required": ["value"], "properties": { "value": { "not": { "type": "null" } } } },
          "else": { "not": { "required": ["value"] } }
        }
      ]
    },
    "open_ended_date": {
      "description": "Explicit open end instead of null. kind: unknown means an end may exist but is not known.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["open_ended", "date", "unknown"] },
        "date": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "date" } } },
          "then": { "required": ["date"], "properties": { "date": { "$ref": "#/$defs/date" } } },
          "else": { "properties": { "date": { "type": "null" } } }
        }
      ]
    },
    "deadline": {
      "description": "datenmodell.md 2.3. Never a global date plus X: always trigger, interval, counting rule and kind.",
      "type": "object",
      "properties": {
        "trigger": { "$ref": "vocabularies.schema.json#/$defs/event_type" },
        "interval": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "enum": ["calendar_days", "working_days", "months"] },
        "counting_starts": { "type": "string", "enum": ["same_day", "day_after"] },
        "weekend_holiday_rule": { "type": "string", "enum": ["extend_to_next_working_day", "none"] },
        "kind": { "$ref": "vocabularies.schema.json#/$defs/deadline_kind" }
      },
      "required": ["trigger", "interval", "unit", "counting_starts", "weekend_holiday_rule", "kind"],
      "additionalProperties": false
    },
    "approval": {
      "description": "Professional sign-off, separate from publication and validity. datenmodell.md 2.4.",
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["draft", "in_review", "approved", "rejected"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "approved_at": { "$ref": "#/$defs/date" }
      },
      "required": ["state"],
      "additionalProperties": false,
      "if": { "properties": { "state": { "const": "approved" } } },
      "then": { "required": ["reviewer", "approved_at"] }
    },
    "publication": {
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["unpublished", "published", "withdrawn"] }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "validity": {
      "description": "Temporal validity, kept separate from approval and publication so that superseded versions stay evaluable for historical events.",
      "type": "object",
      "properties": {
        "valid_from": { "$ref": "#/$defs/date" },
        "valid_until": { "$ref": "#/$defs/open_ended_date" },
        "supersedes": { "oneOf": [{ "$ref": "#/$defs/version_ref" }, { "type": "null" }] },
        "superseded_by": { "oneOf": [{ "$ref": "#/$defs/version_ref" }, { "type": "null" }] },
        "transitional": { "oneOf": [{ "$ref": "#/$defs/i18n_text" }, { "type": "null" }] }
      },
      "required": ["valid_from", "valid_until", "supersedes", "superseded_by", "transitional"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "next_check": { "$ref": "#/$defs/date" },
        "cycle": { "$ref": "vocabularies.schema.json#/$defs/review_cycle" }
      },
      "required": ["next_check", "cycle"],
      "additionalProperties": false
    },
    "source_ref": {
      "description": "Reference to an entry in content/sources with the exact passage and the date the content was checked. A fresh fetch date proves nothing about the content.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reference": { "type": "string", "minLength": 1 },
        "checked": { "$ref": "#/$defs/date" }
      },
      "required": ["id", "reference", "checked"],
      "additionalProperties": false
    },
    "lifecycle": {
      "description": "Fields every approvable dataset carries. Composed into rule, task, procedure and page.",
      "type": "object",
      "properties": {
        "synthetic": {
          "description": "true marks an example that must never be approved or published.",
          "type": "boolean"
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
        "approval": { "$ref": "#/$defs/approval" },
        "publication": { "$ref": "#/$defs/publication" },
        "validity": { "$ref": "#/$defs/validity" },
        "review": { "$ref": "#/$defs/review" }
      },
      "required": ["synthetic", "sources", "approval", "publication", "validity", "review"]
    }
  }
}
