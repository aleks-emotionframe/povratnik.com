{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leben-in-kroatien.example/schemas/page.schema.json",
  "title": "Page",
  "description": "One language version of a content page. Each language version has its own status, version and check date (datenmodell.md section 6). A topic page carries the fixed mask of inhaltskonzept.md 4.2 in sections; every field there is optional so that a short page can leave out what is not yet researched, and the page shows the gap instead of an empty cell.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/lifecycle"
    }
  ],
  "properties": {
    "id": {
      "description": "Slug. The file name is <id>.<lang>.yaml.",
      "$ref": "common.schema.json#/$defs/id"
    },
    "lang": {
      "$ref": "vocabularies.schema.json#/$defs/language"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "synthetic": true,
    "type": {
      "type": "string",
      "enum": [
        "topic",
        "category",
        "procedure",
        "glossary",
        "country",
        "situation",
        "figures",
        "news"
      ]
    },
    "depth": {
      "description": "Two depth levels, visible to the reader. inhaltskonzept.md 4.1.",
      "type": "string",
      "enum": [
        "full",
        "short"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "short_answer": {
      "type": "string",
      "minLength": 1
    },
    "translation": {
      "description": "Only for languages other than de: which German version this translation follows and whether it has been checked since.",
      "type": "object",
      "properties": {
        "of_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "review_due",
            "outdated"
          ]
        }
      },
      "required": [
        "of_version",
        "status"
      ],
      "additionalProperties": false
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/term"
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "procedures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "requires_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "followed_by_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "required": [
        "rules",
        "tasks",
        "procedures",
        "requires_pages",
        "followed_by_pages"
      ],
      "additionalProperties": false
    },
    "sources": true,
    "approval": true,
    "publication": true,
    "validity": true,
    "review": true,
    "category": {
      "description": "Slug of the knowledge category (inhaltskonzept.md 4.1) this page belongs to, as used in the site navigation.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "covers": {
      "description": "Topic names of the category list that this page covers, verbatim.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "description": "The fixed mask of a topic page (inhaltskonzept.md 4.2). Missing field means: not yet researched, shown as such.",
      "type": "object",
      "properties": {
        "applies_to": {
          "type": "string",
          "minLength": 1
        },
        "not_applies_to": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duration_costs": {
          "type": "string",
          "minLength": 1
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "common_mistake": {
          "type": "string",
          "minLength": 1
        },
        "not_decided_here": {
          "type": "string",
          "minLength": 1
        },
        "open_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "country": {
      "description": "Fields of a country page (inhaltskonzept.md 4.3): the departure requirements of the previous country of residence, kept separate from the Croatian process. Each field is a fact with a state; unknown is shown, never left blank.",
      "type": "object",
      "properties": {
        "representation": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "apostille": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "social_security": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "double_taxation": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "deregistration": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "duration": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_collected",
                "outdated"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "representation",
        "apostille",
        "social_security",
        "double_taxation",
        "deregistration",
        "duration"
      ],
      "additionalProperties": false
    },
    "figures": {
      "description": "Rows of a figures page (inhaltskonzept.md 10): each value with its reference date and source id; a missing value is a state, never a blank.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "outdated"
            ]
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "state",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "news": {
      "description": "Fields of a news item (type news): the publication date and the body as paragraphs. inhaltskonzept.md 0 counts news among the supporting areas; a news item carries source and check date like every other page.",
      "type": "object",
      "properties": {
        "published_on": {
          "type": "string",
          "format": "date"
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "published_on",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "lang",
    "version",
    "type",
    "depth",
    "title",
    "short_answer",
    "terms",
    "links"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "lang": {
        "const": "de"
      }
    }
  },
  "then": {
    "not": {
      "required": [
        "translation"
      ]
    }
  },
  "else": {
    "required": [
      "translation"
    ]
  }
}
