{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leben-in-kroatien.example/schemas/calendar.schema.json",
  "title": "Holiday calendar",
  "description": "Public holidays of one country as explicit dates per year. Holidays are domain values (datenmodell.md 2.3): sourced, checked, approved, never in code. Movable holidays are entered per year by the editorial team; there is no Easter algorithm in the repository. File name <id>.yaml.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/lifecycle" }],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "synthetic": true,
    "title": { "$ref": "common.schema.json#/$defs/i18n_text" },
    "country": { "type": "string", "pattern": "^[a-z]{2}$" },
    "legal_basis": { "type": "string", "minLength": 1 },
    "holidays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": { "$ref": "common.schema.json#/$defs/date" },
          "name_hr": { "description": "Official Croatian name, never translated.", "type": "string", "minLength": 1 },
          "name": { "$ref": "common.schema.json#/$defs/i18n_text" },
          "movable": { "description": "true for holidays whose date changes every year.", "type": "boolean" }
        },
        "required": ["date", "name_hr", "name", "movable"],
        "additionalProperties": false
      }
    },
    "sources": true,
    "approval": true,
    "publication": true,
    "validity": true,
    "review": true
  },
  "required": ["id", "title", "country", "legal_basis", "holidays"],
  "additionalProperties": false
}
