---
// Themenseite mit der festen Maske aus inhaltskonzept.md 4.2 (designsystem.md 3, Typ 3).
// Inhalt aus content/pages in der Sprache der Adresse, sonst die deutsche Fassung mit
// Hinweis (lib/pages.ts). Fehlende Felder erscheinen als Zustand, nie als leere Stelle.
// Aufbau wie das Ortsprofil: Sprungleiste, Abschnitte als Tafeln, Seitenspalte als Tafeln.
import Base from "../../../layouts/Base.astro";
import HeroAside from "../../../components/HeroAside.astro";
import { rubricBySlug, rubricText } from "../../../lib/rubrics.ts";
import { loadPages, loadSources, pagePath, type PageView } from "../../../lib/pages.ts";
import { CONTENT_DIR, fmtDate, pageContext } from "../../../lib/page.ts";

export function getStaticPaths() {
  // Pfade aus der deutschen Struktur; die Sprache kommt zur Laufzeit aus der Adresse.
  return loadPages(CONTENT_DIR, "de").map((page) => ({ params: { rubrik: page.category, thema: page.id } }));
}

const { lang, texts, u, p } = pageContext(Astro);
const pages = loadPages(CONTENT_DIR, lang);
const page = pages.find((x) => x.id === Astro.params.thema)!;
const sources = loadSources(CONTENT_DIR);
const rubric = rubricBySlug(page.category!)!;
const s = page.sections;
const state = page.approval.state === "approved" ? { key: "matches", label: u("topic.state_checked") } : { key: "unclear", label: u("topic.state_draft") };
const byId = new Map(pages.map((x) => [x.id, x]));
const requires = page.links.requires_pages.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const followed = page.links.followed_by_pages.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const missing = u("topic.missing");
const explained = (t: { term_explained: Record<string, string | undefined> }) => t.term_explained[lang] ?? t.term_explained.de;
---

<Base title={`${page.title}: povratnik.com`} description={page.short_answer.slice(0, 155)} current="wissen" fallback={page.fallback}>
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href={p("/wissen")}>{u("wissen.crumb")}</a> / <a href={p(`/wissen/${rubric.slug}`)}>{rubricText(rubric, texts).title}</a></p>
        <h1>{page.title}</h1>
        <p class="lede">{page.short_answer}</p>
        <p class="hero__state">
          <span class={`state state--${state.key}`}>{state.label}</span>
          <span class="mono">{u("topic.stand", { date: fmtDate(page.sources[0]?.checked ?? page.validity.valid_from) })}</span>
          {lang !== "de" && !page.fallback && <span class="mono">{u("shell.translation_note")}</span>}
        </p>
      </div>
      <HeroAside title={u("topic.glance_title")}>
        <dl>
          <dt>{u("topic.applies")}</dt><dd>{s.applies_to ?? <span class="state state--unknown">{missing}</span>}</dd>
          <dt>{u("topic.not_applies")}</dt><dd>{s.not_applies_to ?? <span class="state state--unknown">{missing}</span>}</dd>
          <dt>{u("topic.authority")}</dt><dd>{s.authority ?? <span class="state state--unknown">{missing}</span>}</dd>
        </dl>
      </HeroAside>
    </div>
  </section>

  {/* Sprungleiste: breit eine Zeile, schmal eine Klappe mit den Abschnitten untereinander
      (Skript unten setzt das Attribut nach Bildschirmbreite, ohne JavaScript offen). */}
  <details class="jump" open>
    <summary class="container">{u("topic.jump_label")}</summary>
    <nav class="container" aria-label={u("topic.jump_label")}>
      <a href="#voraussetzungen">{u("topic.prerequisites")}</a>
      <a href="#ablauf">{u("topic.steps")}</a>
      <a href="#unterlagen">{u("topic.documents")}</a>
      <a href="#dauer">{u("topic.duration")}</a>
      <a href="#fristen">{u("topic.deadlines")}</a>
      <a href="#klaerung">{u("topic.not_decided")}</a>
      <a href="#quellen">{u("topic.stand_title")}</a>
    </nav>
  </details>
  <script is:inline>
    (function () {
      var box = document.querySelector(".jump");
      var narrow = window.matchMedia("(max-width: 720px)");
      function apply() { box.open = !narrow.matches; }
      apply();
      narrow.addEventListener("change", apply);
    })();
  </script>

  <section class="band band--surface">
    <div class="container grid topic-grid">
      <article class="col-main topic">
        <section class="topic__section" id="voraussetzungen">
          <h2>{u("topic.prerequisites")}</h2>
          {s.prerequisites ? <ul class="rows">{s.prerequisites.map((x) => <li>{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="topic__section" id="ablauf">
          <h2>{u("topic.steps")}</h2>
          {s.steps ? <ol class="rows rows--numbered">{s.steps.map((x) => <li>{x}</li>)}</ol> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="topic__section" id="unterlagen">
          <h2>{u("topic.documents")}</h2>
          {s.documents ? <ul class="rows">{s.documents.map((x) => <li>{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="topic__section" id="dauer">
          <h2>{u("topic.duration")}</h2>
          <p>{s.duration_costs ?? <span class="state state--unknown">{missing}</span>}</p>
        </section>
        <section class="topic__section" id="fristen">
          <h2>{u("topic.deadlines")}</h2>
          {s.deadlines ? <ul class="rows">{s.deadlines.map((x) => <li>{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="topic__section" id="klaerung">
          <h2>{u("topic.not_decided")}</h2>
          <p>{s.not_decided_here ?? <span class="state state--unknown">{missing}</span>}</p>
          {s.open_points && (
            <>
              <h3>{u("topic.open_points")}</h3>
              <ul class="rows">{s.open_points.map((x) => <li><span class="state state--unknown">{u("topic.open")}</span> {x}</li>)}</ul>
            </>
          )}
        </section>
        {page.validity.transitional && <p class="notice" role="note"><strong>{u("topic.validity")}</strong>{page.validity.transitional[lang] ?? page.validity.transitional.de}</p>}
        <section class="topic__section" id="quellen">
          <h2>{u("topic.stand_title")}</h2>
          <dl class="open-field">
            <dt>{u("topic.label")}</dt><dd><span class={`state state--${state.key}`}>{state.label}</span></dd>
            <dt>{u("topic.source")}</dt>
            <dd>
              {page.sources.map((src) => (
                <p class="stand__source">
                  <a href={sources[src.id]?.url} rel="noopener">{sources[src.id]?.title ?? src.id}</a>
                  <span class="mono">{u("topic.source_meta", { publisher: sources[src.id]?.publisher ?? "", tier: sources[src.id]?.tier ?? "", reference: src.reference, date: fmtDate(src.checked) })}</span>
                </p>
              ))}
            </dd>
            <dt>{u("topic.valid_from")}</dt><dd class="mono">{fmtDate(page.validity.valid_from)}{page.validity.valid_until.kind === "date" && ` ${u("topic.valid_until", { date: fmtDate(page.validity.valid_until.date!) })}`}</dd>
            <dt>{u("topic.next_check")}</dt><dd class="mono">{fmtDate(page.review.next_check)}</dd>
            <dt>{u("topic.report")}</dt><dd><a href={`mailto:kontakt@povratnik.com?subject=${encodeURIComponent(u("topic.report_subject", { title: page.title }))}`}>kontakt@povratnik.com</a></dd>
          </dl>
        </section>
      </article>

      <aside class="col-aside">
        <div class="side">
          <h3>{u("topic.mistake")}</h3>
          <p class="side__text">{s.common_mistake ?? <span class="state state--unknown">{missing}</span>}</p>
        </div>
        {page.terms.length > 0 && (
          <div class="side">
            <h3>{u("topic.terms")}</h3>
            <dl class="terms">
              {page.terms.map((t) => (
                <>
                  <dt lang="hr">{t.term_hr}</dt>
                  <dd>{explained(t)}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
        {requires.length > 0 && (
          <div class="side">
            <h3>{u("topic.requires")}</h3>
            <ul class="side__list">{requires.map((x) => <li><a href={p(pagePath(x))}>{x.title}</a></li>)}</ul>
          </div>
        )}
        {followed.length > 0 && (
          <div class="side">
            <h3>{u("topic.followed")}</h3>
            <ul class="side__list">{followed.map((x) => <li><a href={p(pagePath(x))}>{x.title}</a></li>)}</ul>
          </div>
        )}
        <div class="side side--cta">
          <h3>{u("topic.cta_title")}</h3>
          <p>{u("topic.cta_text")}</p>
          <a class="button" href={p("/mein-weg")}>{u("shell.cta")}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .hero__state {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 1.25rem 0 0;
    color: var(--on-brand-soft);
  }
  /* Sprungleiste unter dem Aufmacher. */
  .jump {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .jump summary {
    display: none;
  }
  .jump nav {
    display: flex;
    gap: 0 1.75rem;
  }
  .jump a {
    flex: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.9rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .jump a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  @media (max-width: 720px) {
    /* Schmal: Klappe mit Pfeil, darunter die Abschnitte untereinander, je 44 px hoch. */
    .jump summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 44px;
      list-style: none;
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.9375rem;
      color: var(--ink);
    }
    .jump summary::-webkit-details-marker {
      display: none;
    }
    .jump summary::after {
      content: "";
      width: 0.65rem;
      height: 0.65rem;
      border-right: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      transform: rotate(45deg);
      margin-right: 0.35rem;
      transition: transform var(--dur) var(--ease);
    }
    .jump[open] summary::after {
      transform: rotate(-135deg);
    }
    .jump nav {
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.5rem;
    }
    .jump a {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding-block: 0.5rem;
      border-top: 1px solid var(--line);
      border-bottom: 0;
      white-space: normal;
    }
  }
  /* Tafeln über zwei Drittel, Seitenspalte ein Drittel, gleiche Kanten. */
  @media (min-width: 1100px) {
    .topic-grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 1.25rem;
    }
    .topic-grid .col-main {
      grid-column: 1 / 3;
    }
    .topic-grid .col-aside {
      grid-column: 3;
    }
  }
  /* Linke Spalte: ein Dokument mit Abschnitten, getrennt durch feine Linien; eine
     Listenform für alles (Zeilen mit Trennlinie, keine Symbole). */
  .topic {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding-inline: clamp(1rem, 3vw, 2rem);
  }
  .topic__section {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }
  .topic__section:first-child {
    border-top: 0;
  }
  .topic__section h2 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .topic__section h3 {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }
  .topic__section > p {
    margin: 0;
    max-width: none;
  }
  .topic .notice {
    margin-block: 0.5rem;
  }
  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
  }
  .rows li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .rows li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .rows li:last-child {
    padding-bottom: 0;
  }
  /* Ablauf: die Reihenfolge als schlichte Zahl in Akzentfarbe am Zeilenanfang. */
  .rows--numbered {
    counter-reset: step;
  }
  .rows--numbered li {
    counter-increment: step;
    display: flex;
    gap: 0.75rem;
  }
  .rows--numbered li::before {
    content: counter(step);
    flex: none;
    min-width: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent);
  }
  .topic .open-field {
    max-width: none;
  }
  .topic .open-field dt:first-of-type,
  .topic .open-field dd:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .stand__source {
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.15rem;
  }
  .stand__source .mono {
    color: var(--muted);
  }
  .terms {
    margin: 0;
  }
  .terms dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent-deep);
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .terms dt:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .terms dd {
    margin: 0.15rem 0 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
