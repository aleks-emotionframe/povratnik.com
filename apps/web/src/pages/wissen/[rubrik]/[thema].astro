---
// Themenseite mit der festen Maske aus inhaltskonzept.md 4.2 (designsystem.md 3, Typ 3).
// Inhalt aus content/pages in der Sprache der Adresse, sonst die deutsche Fassung mit
// Hinweis (lib/pages.ts). Fehlende Felder erscheinen als Zustand, nie als leere Stelle.
// Aufbau wie das Ortsprofil: Sprungleiste, Abschnitte als Tafeln, Seitenspalte als Tafeln.
import Base from "../../../layouts/Base.astro";
import { rubricBySlug, rubricText } from "../../../lib/rubrics.ts";
import { loadPages, loadSources, pagePath, type PageView } from "../../../lib/pages.ts";
import { CONTENT_DIR, fmtDate, pageContext } from "../../../lib/page.ts";

export function getStaticPaths() {
  // Pfade aus der deutschen Struktur; die Sprache kommt zur Laufzeit aus der Adresse.
  return loadPages(CONTENT_DIR, "de").map((page) => ({ params: { rubrik: page.category, thema: page.id } }));
}

const { lang, texts, u, p } = pageContext(Astro);
const pages = loadPages(CONTENT_DIR, lang);
const page = pages.find((x) => x.id === Astro.params.thema)!;
const sources = loadSources(CONTENT_DIR);
const rubric = rubricBySlug(page.category!)!;
const s = page.sections;
const state = page.approval.state === "approved" ? { key: "matches", label: u("topic.state_checked") } : { key: "unclear", label: u("topic.state_draft") };
const byId = new Map(pages.map((x) => [x.id, x]));
const requires = page.links.requires_pages.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const followed = page.links.followed_by_pages.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const missing = u("topic.missing");
const explained = (t: { term_explained: Record<string, string | undefined> }) => t.term_explained[lang] ?? t.term_explained.de;
---

<Base title={`${page.title}: povratnik.com`} description={page.short_answer.slice(0, 155)} current="wissen" fallback={page.fallback}>
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href={p("/wissen")}>{u("wissen.crumb")}</a> / <a href={p(`/wissen/${rubric.slug}`)}>{rubricText(rubric, texts).title}</a></p>
        <h1>{page.title}</h1>
        <p class="lede">{page.short_answer}</p>
        <p class="hero__state">
          <span class={`state state--${state.key}`}>{state.label}</span>
          <span class="mono">{u("topic.stand", { date: fmtDate(page.sources[0]?.checked ?? page.validity.valid_from) })}</span>
          {lang !== "de" && !page.fallback && <span class="mono">{u("shell.translation_note")}</span>}
        </p>
      </div>
      <div class="hero__media hero__media--plain">
        <dl class="glance">
          <dt>{u("topic.applies")}</dt><dd>{s.applies_to ?? <span class="state state--unknown">{missing}</span>}</dd>
          <dt>{u("topic.not_applies")}</dt><dd>{s.not_applies_to ?? <span class="state state--unknown">{missing}</span>}</dd>
          <dt>{u("topic.authority")}</dt><dd>{s.authority ?? <span class="state state--unknown">{missing}</span>}</dd>
        </dl>
      </div>
    </div>
  </section>

  <nav class="jump" aria-label={u("topic.jump_label")}>
    <div class="container">
      <a href="#voraussetzungen">{u("topic.prerequisites")}</a>
      <a href="#ablauf">{u("topic.steps")}</a>
      <a href="#unterlagen">{u("topic.documents")}</a>
      <a href="#dauer">{u("topic.duration")}</a>
      <a href="#fristen">{u("topic.deadlines")}</a>
      <a href="#fehler">{u("topic.mistake")}</a>
      <a href="#quellen">{u("topic.stand_title")}</a>
    </div>
  </nav>

  <section class="band band--surface">
    <div class="container grid topic-grid">
      <div class="col-main topic">
        <section class="panel" id="voraussetzungen">
          <h2>{u("topic.prerequisites")}</h2>
          {s.prerequisites ? <ul class="checks">{s.prerequisites.map((x) => <li>{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="panel" id="ablauf">
          <h2>{u("topic.steps")}</h2>
          {s.steps ? <ol class="steps">{s.steps.map((x) => <li>{x}</li>)}</ol> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="panel" id="unterlagen">
          <h2>{u("topic.documents")}</h2>
          {s.documents ? <ul class="checks checks--doc">{s.documents.map((x) => <li>{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="panel" id="dauer">
          <h2>{u("topic.duration")}</h2>
          <p>{s.duration_costs ?? <span class="state state--unknown">{missing}</span>}</p>
        </section>
        <section class="panel" id="fristen">
          <h2>{u("topic.deadlines")}</h2>
          {s.deadlines ? <ul class="deadlines">{s.deadlines.map((x) => <li class="deadline">{x}</li>)}</ul> : <p><span class="state state--unknown">{missing}</span></p>}
        </section>
        <section class="panel panel--mistake" id="fehler">
          <h2>{u("topic.mistake")}</h2>
          <p>{s.common_mistake ?? <span class="state state--unknown">{missing}</span>}</p>
        </section>
        <section class="panel">
          <h2>{u("topic.not_decided")}</h2>
          <p>{s.not_decided_here ?? <span class="state state--unknown">{missing}</span>}</p>
          {s.open_points && (
            <>
              <h3>{u("topic.open_points")}</h3>
              <ul class="checks checks--open">{s.open_points.map((x) => <li><span class="state state--unknown">{u("topic.open")}</span> {x}</li>)}</ul>
            </>
          )}
        </section>
        {page.validity.transitional && <p class="notice" role="note"><strong>{u("topic.validity")}</strong>{page.validity.transitional[lang] ?? page.validity.transitional.de}</p>}
        <section class="panel" id="quellen">
          <h2>{u("topic.stand_title")}</h2>
          <dl class="open-field">
            <dt>{u("topic.label")}</dt><dd><span class={`state state--${state.key}`}>{state.label}</span></dd>
            <dt>{u("topic.source")}</dt>
            <dd>
              {page.sources.map((src) => (
                <p class="stand__source">
                  <a href={sources[src.id]?.url} rel="noopener">{sources[src.id]?.title ?? src.id}</a>
                  <span class="mono">{u("topic.source_meta", { publisher: sources[src.id]?.publisher ?? "", tier: sources[src.id]?.tier ?? "", reference: src.reference, date: fmtDate(src.checked) })}</span>
                </p>
              ))}
            </dd>
            <dt>{u("topic.valid_from")}</dt><dd class="mono">{fmtDate(page.validity.valid_from)}{page.validity.valid_until.kind === "date" && ` ${u("topic.valid_until", { date: fmtDate(page.validity.valid_until.date!) })}`}</dd>
            <dt>{u("topic.next_check")}</dt><dd class="mono">{fmtDate(page.review.next_check)}</dd>
            <dt>{u("topic.report")}</dt><dd><a href={`mailto:kontakt@povratnik.com?subject=${encodeURIComponent(u("topic.report_subject", { title: page.title }))}`}>kontakt@povratnik.com</a></dd>
          </dl>
        </section>
      </div>

      <aside class="col-aside">
        {page.terms.length > 0 && (
          <div class="side">
            <h3>{u("topic.terms")}</h3>
            <dl class="terms">
              {page.terms.map((t) => (
                <>
                  <dt lang="hr">{t.term_hr}</dt>
                  <dd>{explained(t)}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
        {requires.length > 0 && (
          <div class="side">
            <h3>{u("topic.requires")}</h3>
            <ul class="side__list">{requires.map((x) => <li><a href={p(pagePath(x))}>{x.title}</a></li>)}</ul>
          </div>
        )}
        {followed.length > 0 && (
          <div class="side">
            <h3>{u("topic.followed")}</h3>
            <ul class="side__list">{followed.map((x) => <li><a href={p(pagePath(x))}>{x.title}</a></li>)}</ul>
          </div>
        )}
        <div class="side side--cta">
          <h3>{u("topic.cta_title")}</h3>
          <p>{u("topic.cta_text")}</p>
          <a class="button" href={p("/mein-weg")}>{u("shell.cta")}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--on-brand);
  }
  .hero__state {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 1.25rem 0 0;
    color: var(--on-brand-soft);
  }
  .hero__media--plain {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    min-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (min-width: 860px) {
    .hero__media--plain {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
  /* Gilt für, gilt nicht für, zuständig: als Tabelle auf Nachtblau. */
  .glance {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1.25rem;
    max-width: none;
    font-size: 0.9375rem;
    width: 100%;
  }
  .glance dt,
  .glance dd {
    margin: 0;
    padding: 0.6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .glance dt:first-of-type,
  .glance dd:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .glance dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--on-brand-soft);
  }
  .glance dd {
    color: var(--on-brand);
  }
  .glance .state {
    color: var(--on-brand-soft);
  }
  /* Sprungleiste unter dem Aufmacher. */
  .jump {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .jump .container {
    display: flex;
    gap: 0 1.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump a {
    flex: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.9rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .jump a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  /* Tafeln über zwei Drittel, Seitenspalte ein Drittel, gleiche Kanten. */
  @media (min-width: 1100px) {
    .topic-grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 1.25rem;
    }
    .topic-grid .col-main {
      grid-column: 1 / 3;
    }
    .topic-grid .col-aside {
      grid-column: 3;
    }
  }
  .topic {
    display: grid;
    gap: 1.25rem;
  }
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem 1.5rem;
    scroll-margin-top: 6rem;
  }
  .panel h2 {
    font-size: 1.25rem;
    margin: 0 0 0.85rem;
  }
  .panel h3 {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }
  .panel > p {
    margin: 0;
    max-width: none;
  }
  .panel--mistake {
    background: var(--st-unknown-bg);
    border-color: oklch(88% 0.06 85);
  }
  .checks,
  .steps,
  .deadlines {
    padding: 0;
    margin: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    max-width: none;
  }
  .checks li {
    padding-left: 1.85rem;
    position: relative;
  }
  .checks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--surface-blue);
    color: var(--accent);
    font-size: 0.75rem;
    display: grid;
    place-items: center;
  }
  .checks--doc li::before {
    content: "▪";
  }
  .checks--open li::before {
    content: none;
  }
  .checks--open li {
    padding-left: 0;
  }
  .steps {
    counter-reset: step;
    gap: 0.75rem;
  }
  .steps li {
    counter-increment: step;
    padding-left: 2.5rem;
    position: relative;
    min-height: 1.75rem;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    display: grid;
    place-items: center;
  }
  .deadlines .deadline {
    font-family: var(--font-text);
    font-size: 1rem;
    padding: 0.35rem 0 0.35rem 0.85rem;
    border-left: 3px solid var(--accent);
  }
  .panel .open-field {
    max-width: none;
  }
  .panel .open-field dt:first-of-type,
  .panel .open-field dd:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .stand__source {
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.15rem;
  }
  .stand__source .mono {
    color: var(--muted);
  }
  /* Seitenspalte als Tafeln. */
  .side {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
    margin-bottom: 1.25rem;
  }
  .side h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .terms {
    margin: 0;
  }
  .terms dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent-deep);
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .terms dt:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .terms dd {
    margin: 0.15rem 0 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .side__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .side__list li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
  }
  .side__list li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .side__list a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .side--cta {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .side--cta h3 {
    color: var(--on-brand);
    margin: 0;
  }
  .side--cta p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--on-brand-soft);
  }
  .side--cta .button {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
</style>
