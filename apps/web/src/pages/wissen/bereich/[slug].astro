---
// Bereichsseite (inhaltskonzept.md 4.1): die Rubriken eines der vier Bereiche als
// Karten mit Einleitung und der Zahl ihrer Themenseiten; Rubriken ohne Seite tragen
// ihren Zustand sichtbar. Darunter die anderen drei Bereiche zum direkten Wechsel.
import Base from "../../../layouts/Base.astro";
import { RUBRIC_GROUPS, groupBySlug, rubricBySlug, rubricText } from "../../../lib/rubrics.ts";
import { loadPages } from "../../../lib/pages.ts";
import { CONTENT_DIR, pageContext } from "../../../lib/page.ts";

export function getStaticPaths() {
  return RUBRIC_GROUPS.map((g) => ({ params: { slug: g.slug } }));
}

const { lang, texts, u, p } = pageContext(Astro);
const group = groupBySlug(Astro.params.slug!)!;
const title = u(`wissen.group_${group.key}`);
const pages = loadPages(CONTENT_DIR, lang);
const count = (slug: string) => pages.filter((x) => x.category === slug).length;
const others = RUBRIC_GROUPS.filter((g) => g.key !== group.key);
---

<Base title={`${title}: povratnik.com`} description={u("wissen.description")} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href={p("/wissen")}>{u("wissen.crumb")}</a></p>
        <h1>{title}</h1>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <ul class="cards rubrics">
        {group.rubrics.map((slug) => {
          const r = rubricBySlug(slug)!;
          const tx = rubricText(r, texts);
          const n = count(slug);
          return (
            <li class="card card--link">
              <div class="card__body">
                <h3><a href={p(`/wissen/${slug}`)}>{tx.title}</a></h3>
                <p>{tx.intro}</p>
                {n > 0 ? (
                  <span class="arrow-link">{u(n === 1 ? "wissen.pages_one" : "wissen.pages_many", { n })}</span>
                ) : (
                  <span class="state state--unknown">{u("wissen.topics_wip", { n: r.topics.length })}</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
      <h2 class="others">{u("wissen.other_groups")}</h2>
      <ul class="topics others__list">
        {others.map((g) => (
          <li>
            <span>{u(`wissen.group_${g.key}`)}</span>
            <a class="arrow-link" href={p(`/wissen/bereich/${g.slug}`)}>{u("wissen.rubrics_n", { n: g.rubrics.length })}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--on-brand);
  }
  /* Zwei bis vier Rubriken in einer Reihe, ab 1000 px so viele Spalten wie Karten. */
  .rubrics {
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .rubrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .rubrics {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
  }
  .others {
    font-size: 1.125rem;
    margin: 2.5rem 0 0.5rem;
  }
  .others__list {
    max-width: 40rem;
  }
</style>
