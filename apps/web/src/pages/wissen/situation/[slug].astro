---
// Einstieg nach Lebenssituation (inhaltskonzept.md 4.3): ein kuratierter Pfad durch
// bestehende Themenseiten, kein neuer Inhalt.
import Base from "../../../layouts/Base.astro";
import { SITUATIONS, situationBySlug, situationText } from "../../../lib/situations.ts";
import { rubricBySlug, rubricText } from "../../../lib/rubrics.ts";
import { loadPages, pagePath, type PageView } from "../../../lib/pages.ts";
import { CONTENT_DIR, pageContext } from "../../../lib/page.ts";

export function getStaticPaths() {
  return SITUATIONS.map((s) => ({ params: { slug: s.slug } }));
}

const { lang, texts, u, p } = pageContext(Astro);
const pages = loadPages(CONTENT_DIR, lang);
const situation = situationBySlug(Astro.params.slug!)!;
const tx = situationText(situation, texts);
const byId = new Map(pages.map((x) => [x.id, x]));
const steps = situation.path.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const rubrics = situation.rubrics.map((s) => rubricBySlug(s)!);
const stateOf = (x: PageView) => (x.approval.state === "approved" ? { key: "matches", label: u("topic.state_checked") } : { key: "unclear", label: u("topic.state_draft") });
---

<Base title={`${tx.title}: povratnik.com`} description={tx.intro} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href={p("/wissen")}>{u("wissen.crumb")}</a> / {u("situation.crumb")}</p>
        <h1>{tx.title}</h1>
        <p class="lede">{tx.intro}</p>
      </div>
      <div class="hero__media hero__media--plain">
        <div>
          <h2 class="trap__title">{u("situation.trap_title")}</h2>
          <p class="trap">{tx.trap}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container grid">
      <div class="col-main">
        <h2>{u("situation.path_title")}</h2>
        <ol class="path">
          {steps.map((x) => (
            <li class="path__step">
              <a href={p(pagePath(x))}>{x.title}</a>
              <p>{x.short_answer}</p>
              <span class={`state state--${stateOf(x).key}`}>{stateOf(x).label}</span>
            </li>
          ))}
        </ol>
      </div>
      <aside class="col-aside">
        <div class="side">
          <h3>{u("situation.rubrics_title")}</h3>
          <ul class="side__list">
            {rubrics.map((r) => <li><a href={p(`/wissen/${r.slug}`)}>{r.number} {rubricText(r, texts).title}</a></li>)}
          </ul>
        </div>
        <div class="side side--cta">
          <h3>{u("situation.cta_title")}</h3>
          <p>{u("situation.cta_text")}</p>
          <a class="button button--primary" href={p("/mein-weg")}>{u("shell.cta")}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--on-brand);
  }
  .hero__media--plain {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    min-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (min-width: 860px) {
    .hero__media--plain {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
  .trap__title {
    font-size: 1rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.5rem;
  }
  .trap {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--on-brand);
    max-width: 34ch;
    margin: 0;
  }
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
    max-width: none;
    display: grid;
    gap: 0.75rem;
  }
  .path__step {
    counter-increment: step;
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem 1.1rem 4rem;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .path__step::before {
    content: counter(step);
    position: absolute;
    left: 1.25rem;
    top: 1.1rem;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    display: grid;
    place-items: center;
  }
  .path__step a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--ink);
  }
  .path__step a:hover {
    color: var(--accent);
  }
  .path__step p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .side {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .side h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .side__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .side__list li {
    padding: 0.35rem 0;
  }
  .side__list a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .side--cta {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .side--cta p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
