---
// Einstieg nach Lebenssituation (inhaltskonzept.md 4.3): ein kuratierter Pfad durch
// bestehende Themenseiten, kein neuer Inhalt.
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import { SITUATIONS, situationBySlug } from "../../../lib/situations.ts";
import { rubricBySlug } from "../../../lib/rubrics.ts";
import { loadPages, pagePath, pageState, type PageView } from "../../../lib/pages.ts";

export function getStaticPaths() {
  const pages = loadPages(join(process.cwd(), "..", "..", "content"));
  return SITUATIONS.map((s) => ({ params: { slug: s.slug }, props: { pages } }));
}

const { pages } = Astro.props as { pages: PageView[] };
const situation = situationBySlug(Astro.params.slug!)!;
const byId = new Map(pages.map((p) => [p.id, p]));
const steps = situation.path.map((id) => byId.get(id)).filter(Boolean) as PageView[];
const rubrics = situation.rubrics.map((s) => rubricBySlug(s)!);
---

<Base title={`${situation.title}: povratnik.com`} description={situation.intro} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href="/wissen">Wissen</a> / Lebenssituation</p>
        <h1>{situation.title}</h1>
        <p class="lede">{situation.intro}</p>
      </div>
      <div class="hero__media hero__media--plain">
        <div>
          <h2 class="trap__title">Woran es hier oft scheitert</h2>
          <p class="trap">{situation.trap}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container grid">
      <div class="col-main">
        <h2>Ihr Weg in dieser Reihenfolge</h2>
        <ol class="path">
          {steps.map((p) => (
            <li class="path__step">
              <a href={pagePath(p)}>{p.title}</a>
              <p>{p.short_answer}</p>
              <span class={`state state--${pageState(p).key}`}>{pageState(p).label}</span>
            </li>
          ))}
        </ol>
      </div>
      <aside class="col-aside">
        <div class="side">
          <h3>Diese Rubriken zählen zusätzlich</h3>
          <ul class="side__list">
            {rubrics.map((r) => <li><a href={`/wissen/${r.slug}`}>{r.number} {r.title}</a></li>)}
          </ul>
        </div>
        <div class="side side--cta">
          <h3>Persönlich statt allgemein</h3>
          <p>Der Kurzcheck macht aus diesem Pfad Ihren Plan, Person für Person, mit Fristen.</p>
          <a class="button button--primary" href="/mein-weg">Kurzcheck starten</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--on-brand);
  }
  .hero__media--plain {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    min-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (min-width: 860px) {
    .hero__media--plain {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
  .trap__title {
    font-size: 1rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.5rem;
  }
  .trap {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--on-brand);
    max-width: 34ch;
    margin: 0;
  }
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
    max-width: none;
    display: grid;
    gap: 0.75rem;
  }
  .path__step {
    counter-increment: step;
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem 1.1rem 4rem;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .path__step::before {
    content: counter(step);
    position: absolute;
    left: 1.25rem;
    top: 1.1rem;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    display: grid;
    place-items: center;
  }
  .path__step a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--ink);
  }
  .path__step a:hover {
    color: var(--accent);
  }
  .path__step p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .side {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .side h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .side__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .side__list li {
    padding: 0.35rem 0;
  }
  .side__list a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .side--cta {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .side--cta p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
