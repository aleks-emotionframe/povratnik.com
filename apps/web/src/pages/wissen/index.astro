---
// Übersicht Wissen: die vier Bereiche (inhaltskonzept.md 4.1) als Karten, jede mit
// den Namen ihrer Rubriken; die Rubriken selbst stehen auf der Bereichsseite.
import Base from "../../layouts/Base.astro";
import { RUBRIC_GROUPS, rubricBySlug, rubricText } from "../../lib/rubrics.ts";
import { pageContext } from "../../lib/page.ts";

const { texts, u, p } = pageContext(Astro);
---

<Base title={`${u("wissen.title")}: povratnik.com`} description={u("wissen.description")} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <h1>{u("wissen.title")}</h1>
        <p class="lede">{u("wissen.lede")}</p>
      </div>
      <nav class="hero__media hero__aside" aria-label={u("wissen.more_title")}>
        <h2>{u("wissen.more_title")}</h2>
        <ul class="topics">
          <li><span>{u("wissen.more_situations")}</span><a class="arrow-link" href={p("/wissen/situation")}>{u("wissen.more_situations_link")}</a></li>
          <li><span>{u("wissen.more_glossary")}</span><a class="arrow-link" href={p("/wissen/glossar")}>{u("wissen.more_glossary_link")}</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <ul class="cards groups">
        {RUBRIC_GROUPS.map((g) => (
          <li class="card card--link">
            <div class="card__media card__media--list" aria-hidden="true">
              <ul>
                {g.rubrics.map((slug) => { const r = rubricBySlug(slug)!; return <li>{rubricText(r, texts).title}</li>; })}
              </ul>
            </div>
            <div class="card__body">
              <h3><a href={p(`/wissen/bereich/${g.slug}`)}>{u(`wissen.group_${g.key}`)}</a></h3>
              <span class="arrow-link">{u("wissen.rubrics_n", { n: g.rubrics.length })}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>

<style>
  /* Vier Bereiche: auf dem Handy untereinander, ab 560 px zwei nebeneinander, ab 1000 px
     alle vier in einer Reihe, damit die ganze Übersicht ohne Scrollen sichtbar ist. */
  .groups {
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Die Liste ist nur so hoch wie ihre Einträge; sie füllt die Karte, damit die Titel
     in einer Reihe auf gleicher Höhe stehen. */
  .groups .card__media {
    aspect-ratio: auto;
    flex: 1;
    padding-bottom: 1.75rem;
  }
  /* Ohne Nummern: ein kleiner Punkt in Akzentfarbe vor jeder Rubrik. */
  .groups .card__media--list li::before {
    content: "";
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.35em;
  }
  /* Rechts im Aufmacher: die Liste der weiteren Zugänge, zum direkten Wechseln. */
  .hero__aside {
    min-height: 0;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    align-self: center;
  }
  .hero__aside h2 {
    font-size: 1.125rem;
    color: var(--on-brand);
    margin-bottom: 0.75rem;
  }
  .hero__aside .topics li {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--on-brand);
  }
  .hero__aside .arrow-link {
    color: var(--accent-bright);
  }
  @media (min-width: 860px) {
    .hero__aside {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
</style>
