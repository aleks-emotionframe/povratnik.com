---
// Übersicht Wissen: die zwölf Rubriken (inhaltskonzept.md 4.1) mit der Zahl ihrer
// Themenseiten; Rubriken ohne Seite tragen ihren Zustand sichtbar.
import Base from "../../layouts/Base.astro";
import { RUBRICS, rubricText } from "../../lib/rubrics.ts";
import { loadPages } from "../../lib/pages.ts";
import { CONTENT_DIR, pageContext } from "../../lib/page.ts";

const { lang, texts, u, p } = pageContext(Astro);
const pages = loadPages(CONTENT_DIR, lang);
const count = (slug: string) => pages.filter((x) => x.category === slug).length;
---

<Base title={`${u("wissen.title")}: povratnik.com`} description={u("wissen.description")} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <h1>{u("wissen.title")}</h1>
        <p class="lede">{u("wissen.lede")}</p>
      </div>
      <nav class="hero__media hero__aside" aria-label={u("wissen.more_title")}>
        <h2>{u("wissen.more_title")}</h2>
        <ul class="topics">
          <li><span>{u("wissen.more_situations")}</span><a class="arrow-link" href={p("/wissen/situation")}>{u("wissen.more_situations_link")}</a></li>
          <li><span>{u("wissen.more_glossary")}</span><a class="arrow-link" href={p("/wissen/glossar")}>{u("wissen.more_glossary_link")}</a></li>
          <li><span>{u("wissen.more_countries")}</span><a class="arrow-link" href={p("/wissen/land")}>{u("wissen.more_countries_link")}</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <ul class="cards rubrics">
        {RUBRICS.map((r) => {
          const tx = rubricText(r, texts);
          const n = count(r.slug);
          return (
            <li class="card card--link">
              <div class="card__body">
                <h3><a href={p(`/wissen/${r.slug}`)}>{tx.title}</a></h3>
                <p>{tx.intro}</p>
                {n > 0 ? (
                  <span class="arrow-link">{u(n === 1 ? "wissen.pages_one" : "wissen.pages_many", { n })}</span>
                ) : (
                  <span class="state state--unknown">{u("wissen.topics_wip", { n: r.topics.length })}</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

</Base>

<style>
  /* Zwölf Rubriken in drei Reihen zu vier, damit keine Reihe halb leer bleibt. */
  .rubrics {
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .rubrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .rubrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Rechts im Aufmacher: die Liste der weiteren Zugänge, zum direkten Wechseln. */
  .hero__aside {
    min-height: 0;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    align-self: center;
  }
  .hero__aside h2 {
    font-size: 1.125rem;
    color: var(--on-brand);
    margin-bottom: 0.75rem;
  }
  .hero__aside .topics li {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--on-brand);
  }
  .hero__aside .arrow-link {
    color: var(--accent-bright);
  }
  @media (min-width: 860px) {
    .hero__aside {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
</style>
