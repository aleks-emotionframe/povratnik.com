---
// Übersicht Wissen: die zwölf Rubriken (inhaltskonzept.md 4.1) mit der Zahl ihrer
// Themenseiten; Rubriken ohne Seite tragen ihren Zustand sichtbar.
import Base from "../../layouts/Base.astro";
import { RUBRICS, rubricText } from "../../lib/rubrics.ts";
import { loadPages } from "../../lib/pages.ts";
import { CONTENT_DIR, pageContext } from "../../lib/page.ts";

const { lang, texts, u, p } = pageContext(Astro);
const pages = loadPages(CONTENT_DIR, lang);
const count = (slug: string) => pages.filter((x) => x.category === slug).length;
---

<Base title={`${u("wissen.title")}: povratnik.com`} description={u("wissen.description")} current="wissen">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <h1>{u("wissen.title")}</h1>
        <p class="lede">{u("wissen.lede")}</p>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <ul class="cards rubrics">
        {RUBRICS.map((r) => {
          const tx = rubricText(r, texts);
          const n = count(r.slug);
          return (
            <li class="card card--link">
              <div class="card__body">
                <h3><a href={p(`/wissen/${r.slug}`)}>{tx.title}</a></h3>
                <p>{tx.intro}</p>
                {n > 0 ? (
                  <span class="arrow-link">{u(n === 1 ? "wissen.pages_one" : "wissen.pages_many", { n })}</span>
                ) : (
                  <span class="state state--unknown">{u("wissen.topics_wip", { n: r.topics.length })}</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>{u("wissen.more_title")}</h2>
      </div>
      <ul class="ways">
        <li><a href={p("/wissen/situation/familie")}><span class="ways__title">{u("wissen.more_situations")}</span><span class="ways__text">{u("wissen.more_situations_text")}</span></a></li>
        <li><a href={p("/wissen/glossar")}><span class="ways__title">{u("wissen.more_glossary")}</span><span class="ways__text">{u("wissen.more_glossary_text")}</span></a></li>
        <li><a href={p("/wissen/land/argentinien")}><span class="ways__title">{u("wissen.more_countries")}</span><span class="ways__text">{u("wissen.more_countries_text")}</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Zwölf Rubriken in drei Reihen zu vier, damit keine Reihe halb leer bleibt. */
  .rubrics {
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .rubrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .rubrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Drei Kacheln: Titel, ein Satz, Pfeil; gleiche Höhe. */
  .ways {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .ways {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ways li {
    display: flex;
  }
  .ways a {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    align-content: start;
    padding: 1.25rem 1.35rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .ways a::after {
    content: "→";
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .ways a:hover {
    border-color: var(--accent);
  }
  .ways__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }
  .ways__text {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
</style>
