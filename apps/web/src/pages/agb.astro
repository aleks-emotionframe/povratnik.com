---
// Nutzungshinweise. Der rechtlich geprüfte Text wird mit den Betreiberangaben ergänzt.
import Base from "../layouts/Base.astro";
import { pageContext } from "../lib/page.ts";

const { lang, u } = pageContext(Astro);
---

<Base title="Nutzungshinweise: povratnik.com" description="Was povratnik.com leistet und was nicht.">
  {lang !== "de" && (
    <div class="container"><p class="notice" role="note">{u("shell.legal_note")}</p></div>
  )}
  <section class="band">
    <div class="container grid">
      <div class="col-main">
        <h1>Nutzungshinweise</h1>
        <p>Diese Website informiert. Sie entscheidet keinen Anspruch und ersetzt keine Beratung.</p>

        <h2>Was der Plan ist und was nicht</h2>
        <p>
          Der Plan aus dem Kurzcheck zeigt nach Ihren Angaben mögliche Wege, Aufgaben,
          Fristen und offene Punkte. Über jeden Antrag entscheidet die zuständige Stelle. Wo
          eine Behörde oder Fachperson entscheiden muss, sagt der Plan das ausdrücklich.
        </p>
        <p>
          Regeln tragen Quelle und Prüfdatum. Regeln, die nicht fachlich freigegeben sind,
          werden öffentlich nicht ausgewertet. Prüfen Sie vor einer Antragstellung erneut,
          ob sich der Stand geändert hat.
        </p>

        <h2>Allgemeine Geschäftsbedingungen</h2>
        <dl class="open-field">
          <dt>Vertragsbedingungen</dt>
          <dd><span class="state state--unknown">wird ergänzt</span> Es gibt derzeit keine kostenpflichtigen Leistungen und keine Verträge über diese Website.</dd>
        </dl>
      </div>
    </div>
  </section>
</Base>
