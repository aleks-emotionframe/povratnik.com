---
// Wizard-Seite. Das Regelpaket entsteht zur Bauzeit; im Build nur freigegebene Regeln
// (src/lib/content.ts). Die Insel ist die einzige Stelle mit JavaScript.
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import { Wizard } from "../islands/Wizard.tsx";
import { bundleFor, loadContent } from "../lib/content.ts";
import "../styles/wizard.css";

const contentDir = join(process.cwd(), "..", "..", "content");
const bundle = bundleFor(import.meta.env.PROD ? "build" : "dev", loadContent(contentDir));
const texts = bundle.texts as Record<string, any>;
---

<Base title="Mein Weg nach Kroatien: Kurzcheck" description="Sechs Fragen, dann Ihr erster Plan. Antworten bleiben im Browser." current="mein-weg">
  <section class="band">
    <div class="container grid">
      <div class="col-wide">
        <h1>{texts.wizard.title}</h1>
        <p class="soft">{texts.wizard.intro}</p>
        {bundle.synthetic && (
          <p class="notice" role="note">
            <strong>{texts.wizard.synthetic_banner}</strong>
            {texts.wizard.synthetic_text}
          </p>
        )}
        {bundle.rules.length === 0 && (
          <p class="notice" role="note">
            <strong>{texts.wizard.no_rules_title}</strong>
            {texts.wizard.no_rules_text}
          </p>
        )}
      </div>
    </div>
  </section>
  <section class="band band--surface">
    <div class="container grid">
      <div class="col-wide">
        <noscript>
          <p class="notice"><strong>JavaScript</strong>{texts.wizard.no_js}</p>
        </noscript>
        <Wizard client:load bundle={bundle} />
      </div>
    </div>
  </section>
</Base>
