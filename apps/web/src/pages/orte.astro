---
// Orte entdecken (inhaltskonzept.md 5). Karte, Ortsprofile und Leistungsdatenbank
// kommen in M5 aus der Datenbank (ADR-0001). Bis dahin zeigt die Seite ehrlich, was
// ein Ortsprofil enthalten wird; keine erfundenen Werte für reale Orte (CLAUDE.md 10).
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ort from "../assets/ort-hauptplatz.png";

const sections = [
  ["Überblick", "Gemeinde, Gespanschaft, Lage, Einwohner, Kurzbeschreibung des Alltags. Keine unbelegten Superlative."],
  ["Leistungen der Gemeinde", "Jede Massnahme mit Zielgruppe, Betrag oder Berechnungsart, Bedingungen, Frist, Budgetstatus und Originalausschreibung."],
  ["Familie und Bildung", "Kindergarten, Grundschule, weiterführende Schule, Sprachförderung, Kosten. Kapazität nur mit aktuellem Nachweis."],
  ["Gesundheit", "Hausarzt, Kinderarzt, Apotheke, nächste Klinik, Entfernung. Aufnahme neuer Patienten nur mit Bestätigung."],
  ["Wohnen", "Dauerhafte Miete, Preisniveau mit Datum, kommunaler Wohnraum, Bauland. Inserate und Durchschnittswerte getrennt."],
  ["Arbeit", "Branchen vor Ort, Pendelziele mit Fahrzeit, grosse Arbeitgeber. Fahrzeit ist keine Luftlinie."],
  ["Alltag und Anschluss", "Internet, öffentlicher Verkehr, Sprachkurse, Vereine, Kirche, Einkauf. Saison und Öffnungszeiten berücksichtigt."],
  ["Ankommen", "Zuständiges Büro, Funktion, Sprachen, Antwortweg. Benannter Kontakt nur bei bestätigter Leistung."],
  ["Datentiefe", "Wie vollständig dieser Ort erfasst ist. Ein Ort mit wenig Daten sieht nie aus wie ein Ort ohne Angebote."],
];
---

<Base title="Orte entdecken: povratnik.com" description="Gemeinden in Kroatien mit ihren Leistungen für Rückkehrer, Schulen, Ärzten und Wohnraum. Mit Zustand und Prüfdatum." current="orte">
  <section class="hero">
    <div class="container">
      <div class="hero__text">
        <h1>Orte entdecken</h1>
        <p class="lede">
          Welche Gemeinde fördert Rückkehrer, wo nimmt der Kinderarzt noch Patienten auf, wo
          gibt es Jahresmieten? Ortsprofile mit Zustand und Prüfdatum, ohne Rangliste und ohne
          erfundene Werte.
        </p>
        <div class="hero__actions">
          <span class="state state--unknown">im Aufbau, Etappe M5</span>
        </div>
      </div>
      <div class="hero__media">
        <Image src={ort} alt="Hauptplatz einer kleinen Stadt in Kroatien mit Gemeindehaus und Bäckerei." widths={[640, 960]} sizes="(min-width: 860px) 50vw, 100vw" format="webp" quality={62} loading="eager" />
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <div class="band__head">
        <h2>Was in jedem Ortsprofil stehen wird</h2>
        <p class="soft">Dieselben Abschnitte für jeden Ort, damit Orte vergleichbar sind.</p>
      </div>
      <ul class="cards">
        {sections.map(([title, text]) => (
          <li class="card">
            <div class="card__body">
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container grid">
      <div class="col-main">
        <h2>Kein Ranking, keine Gesamtnote</h2>
        <p>
          Zwei bis drei Orte lassen sich nebeneinander vergleichen, als Rohinformation. Ein
          Gesamtwert würde immer unsere Gewichtung durchsetzen und nicht Ihre. Was fehlt, steht
          als «unbekannt» und nicht als leere Zelle.
        </p>
        <p>
          Die Leistungsdatenbank macht alle Förderungen, national, regional und kommunal,
          auch ohne Karte durchsuchbar: nach Lebensbereich, Zielgruppe, Zustand, Frist und Region.
        </p>
      </div>
      <aside class="col-aside">
        <div class="side--cta">
          <h3>Sie vertreten eine Gemeinde?</h3>
          <p>Tragen Sie Ihre Leistungen für Rückkehrer ein. Jede Angabe erscheint mit Quelle, Prüfdatum und Zustand.</p>
          <a class="button button--primary" href="mailto:kontakt@povratnik.com?subject=Gemeinde%20eintragen">Gemeinde eintragen</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .side--cta {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .side--cta h3 {
    font-size: 1.0625rem;
  }
  .side--cta p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
