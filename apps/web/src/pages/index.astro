---
// Startseite nach inhaltskonzept.md 3 und designsystem.md 2.0: Aufmacher mit Foto,
// Schnelleinstiege, die drei Wege, die vier Schlüssel, die fünf Phasen, die Zustände,
// Einstiege nach Lebenssituation. Wissen und Orte tragen ihren Zustand sichtbar.
import { join } from "node:path";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { RUBRICS } from "../lib/rubrics.ts";
import { SITUATIONS } from "../lib/situations.ts";
import { CASES } from "../lib/cases.ts";
import { loadPlaces, placeName, formatDate, PROGRAM_STATE } from "../lib/places.ts";
import { loadPages, pagePath } from "../lib/pages.ts";
import hero from "../assets/hero-dokumente.webp";
import ort from "../assets/ort-hauptplatz.webp";

const heroImg = await getImage({ src: hero, width: 960, format: "webp", quality: 62 });
const chips = [
  ["OIB", "dokumente-und-behoerden/oib"],
  ["Staatsangehörigkeit über Abstammung", "status-und-staatsangehoerigkeit/staatsangehoerigkeit-abstammung"],
  ["Bescheinigung für Auswanderer", "status-und-staatsangehoerigkeit/bescheinigung-auswanderer"],
  ["Wohnsitz anmelden", "dokumente-und-behoerden/wohnsitz-anmelden"],
  ["Krankenversicherung", "gesundheit-und-pflege/krankenversicherung"],
  ["Fünf Jahre keine Lohnsteuer", "steuern-geld-und-pension/lohnsteuerbefreiung"],
  ["Biram Hrvatsku", "leistungen-und-foerderung/biram-hrvatsku"],
  ["Schule und Zeugnisse", "kinder-schule-und-ausbildung/schule-und-zeugnisse"],
  ["Führerschein", "umzug-und-mobilitaet/fuehrerschein-umschreiben"],
];

// Was gerade läuft: offene und angekündigte Leistungen mit Antragszeitraum, dazu
// Themenseiten mit befristeter Gültigkeit. Der Block ist der Grund für Wiederbesuche.
const places = loadPlaces();
const running = places
  .flatMap((p) => p.benefits.filter((b) => b.program_state === "open" || b.program_state === "announced").map((b) => ({ title: b.title, where: placeName(p), href: `/orte/${p.id}`, until: b.application.until, state: b.program_state, checked: b.checked })))
  .sort((a, b) => (a.until ?? "9").localeCompare(b.until ?? "9"));
const dated = loadPages(join(process.cwd(), "..", "..", "content")).filter((p) => p.validity.valid_until.kind === "date");
---

<Base
  title="povratnik.com: Leben in Kroatien"
  description="Rückkehr und Auswanderung nach Kroatien in der richtigen Reihenfolge: Aufenthalt, Meldung, Versicherung, Familie, Förderung. Persönlicher Plan im Browser, ohne Konto."
  current="start"
  preload={heroImg.src}
>
  <section class="hero">
    <div class="container">
      <div class="hero__text">
        <h1>Nach Kroatien zurück oder neu dorthin. In der richtigen Reihenfolge.</h1>
        <p class="lede">
          Aufenthalt, Meldung, Versicherung, Schule, Förderung: Was zuerst kommt, steht
          nirgends. Hier bekommen Sie die Reihenfolge für Ihren Haushalt, Person für Person.
        </p>
        <div class="hero__actions">
          <a class="button button--light" href="/mein-weg">Kurzcheck starten</a>
          <a class="button button--outline-light" href="/wissen">Wissen nach Thema</a>
        </div>
        <p class="hero__note">Ohne Konto. Ihre Antworten bleiben in Ihrem Browser.</p>
      </div>
      <div class="hero__media">
        <Image src={hero} alt="Eine Frau und ihr Vater sortieren an einem Tisch in einer Altstadt Unterlagen." widths={[640, 960]} sizes="(min-width: 860px) 50vw, 100vw" format="webp" quality={62} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="band band--surface quick">
    <div class="container">
      <h2 class="quick__title">Suchen Sie etwas Bestimmtes?</h2>
      <ul class="chips">
        {chips.map(([label, slug]) => <li><a href={`/wissen/${slug}`}>{label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>Drei Wege zum selben Wissen</h2>
        <p class="soft">Nach Thema, nach Ort oder nach Ihrer Reihenfolge.</p>
      </div>
      <ul class="cards cards--ways">
        <li class="card card--link">
          <div class="card__media">
            <Image src={hero} alt="" width={640} height={427} format="webp" loading="lazy" />
          </div>
          <div class="card__body">
            <h3><a href="/mein-weg">Mein Weg</a></h3>
            <p>Sechs Fragen zu Ihrem Haushalt, dann ein erster Plan: was zuerst, welche Frist wodurch ausgelöst wird, was offen bleibt.</p>
            <span class="arrow-link">Kurzcheck starten</span>
          </div>
        </li>
        <li class="card card--link">
          <div class="card__media card__media--list" aria-hidden="true">
            <ol>
              {RUBRICS.slice(0, 5).map((r) => <li><span class="mono">{r.number}</span> {r.title}</li>)}
            </ol>
          </div>
          <div class="card__body">
            <h3><a href="/wissen">Wissen nach Thema</a></h3>
            <p>Zwölf Rubriken, von Status bis Förderung. Jede Themenseite mit derselben Maske: kurze Antwort, gilt für, zuständig, Stand.</p>
            <span class="arrow-link">Zu den Rubriken</span>
          </div>
        </li>
        <li class="card card--link">
          <div class="card__media">
            <Image src={ort} alt="" width={640} height={427} format="webp" loading="lazy" />
          </div>
          <div class="card__body">
            <h3><a href="/orte">Orte entdecken</a></h3>
            <p>Gemeinden mit ihren Leistungen für Rückkehrer, Schulen, Ärzten und Wohnraum. Mit Zustand, Prüfdatum und Datentiefe, ohne Rangliste.</p>
            <span class="arrow-link">Orte und Leistungen</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <div class="band__head">
        <h2>Fast alles hängt an vier Schlüsseln</h2>
        <p class="soft">Und zwar in dieser Reihenfolge. Das ist der rote Faden der ganzen Website.</p>
      </div>
      <ol class="keys">
        <li class="key">
          <h3>Status</h3>
          <span class="key__hr">Wer bin ich rechtlich?</span>
          <p>Entscheidet über den Aufenthaltsweg, den Zugang zu Arbeit, Schule und Förderung.</p>
        </li>
        <li class="key">
          <h3>OIB</h3>
          <span class="key__hr" lang="hr">osobni identifikacijski broj</span>
          <p>Die Steuernummer. Ohne sie kein Bankkonto, kein Mietvertrag, kein Antrag, kein Arbeitsvertrag.</p>
        </li>
        <li class="key">
          <h3>Anmeldung</h3>
          <span class="key__hr" lang="hr">prijava prebivališta</span>
          <p>Löst Fristen aus und ist bei vielen Förderungen das massgebende Datum, nicht die Ankunft.</p>
        </li>
        <li class="key">
          <h3>Versicherung</h3>
          <span class="key__hr" lang="hr">zdravstveno osiguranje</span>
          <p>Ermöglicht Arztbesuch, Schuleinschreibung, Betreuungsplatz. Hat eine Lücke, wenn sie nicht vorher geplant wurde.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>Fünf Phasen, eine davon lassen alle weg</h2>
        <p class="soft">Die fünfte ist die wichtigste: Dort scheitert die Rückkehr, nicht bei der Anmeldung.</p>
      </div>
      <ol class="phases">
        <li class="phase-step"><h3>Orientieren</h3><span class="mono">12 bis 6 Monate vorher</span><p>Ist es machbar? Welcher Statusweg? Welcher Ort? Reicht das Geld?</p></li>
        <li class="phase-step"><h3>Vorbereiten</h3><span class="mono">9 bis 2 Monate vorher</span><p>Dokumente, Aufenthalt, Versicherung, Schule, Wohnung, Herkunftsland.</p></li>
        <li class="phase-step"><h3>Umziehen</h3><span class="mono">4 Wochen vorher bis Ankunft</span><p>Transport, Übergangsdeckung, Anreise, erste Termine.</p></li>
        <li class="phase-step"><h3>Ankommen</h3><span class="mono">erste 8 Wochen</span><p>Anmeldung, Versicherung, Arbeit, Schule, Alltag.</p></li>
        <li class="phase-step"><h3>Bleiben</h3><span class="mono">Monat 3 bis 24</span><p>Verlängerungen, Förderpflichten, Sprache, Anschluss.</p></li>
      </ol>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <div class="band__head">
        <h2>Was gerade läuft</h2>
        <p class="soft">Offene Fristen und aktuelle Massnahmen, mit Zustand und Prüfdatum.</p>
      </div>
      <ul class="running">
        {dated.map((p) => (
          <li class="running__item">
            <span class="state state--matches">läuft</span>
            <a href={pagePath(p)}>{p.title}</a>
            <span class="running__where">staatlich</span>
            <span class="mono">bis {formatDate(p.validity.valid_until.date!)}</span>
            <span class="mono muted">geprüft {formatDate(p.sources[0]?.checked ?? p.validity.valid_from)}</span>
          </li>
        ))}
        {running.map((r) => (
          <li class="running__item">
            <span class={`state state--${PROGRAM_STATE[r.state].css}`}>{PROGRAM_STATE[r.state].label}</span>
            <a href={r.href}>{r.title}</a>
            <span class="running__where">{r.where}</span>
            <span class="mono">{r.until ? `bis ${formatDate(r.until)}` : "Antragszeitraum unbekannt"}</span>
            <span class="mono muted">geprüft {formatDate(r.checked)}</span>
          </li>
        ))}
      </ul>
      <p class="soft running__note">Kommunale Einträge stammen auf der Teststufe aus fiktiven Testgemeinden. <a class="arrow-link" href="/orte/leistungen">Alle Leistungen</a></p>
    </div>
  </section>

  <section class="band band--brand">
    <div class="container grid">
      <div class="col-main">
        <h2>Warum ein Betrag allein nichts sagt</h2>
        <p>
          Eine Förderung kann offen, angekündigt oder ausgeschöpft sein. Ein Wert kann bekannt,
          belegt und trotzdem veraltet sein. Deshalb trägt bei uns jede Angabe Quelle, Prüfdatum
          und Zustand. Wo wir etwas nicht wissen, steht das dort, sichtbar, statt einer Lücke.
        </p>
        <p class="soft">Über Anträge entscheidet immer die zuständige Stelle. Der Plan zeigt den Weg, nicht das Ergebnis.</p>
      </div>
      <aside class="col-aside states-aside">
        <h3>So lesen Sie Zustände</h3>
        <ul class="state-list">
          <li><span class="state state--matches">nach Angaben passend</span> Die Voraussetzungen treffen nach Ihren Angaben zu.</li>
          <li><span class="state state--unclear">unklar</span> Eine Angabe fehlt oder eine Fachperson muss entscheiden.</li>
          <li><span class="state state--condition_missing">Bedingung fehlt</span> Eine Voraussetzung ist derzeit nicht erfüllt.</li>
          <li><span class="state state--unknown">unbekannt</span> Diesen Wert kennen wir noch nicht.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>Einstiege nach Lebenssituation</h2>
        <p class="soft">Dieselben Themen, in der Reihenfolge, die zu Ihnen passt.</p>
      </div>
      <ul class="chips">
        {SITUATIONS.map((s) => <li><a href={`/wissen/situation/${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <div class="band__head">
        <h2>Fünf Beispielwege</h2>
        <p class="soft">Fiktive Fallprofile aus dem Konzept. Echte Erfahrungsberichte folgen, sobald Testpersonen den Plan benutzt haben.</p>
      </div>
      <ul class="cards cases">
        {CASES.map((c) => (
          <li class="card card--link">
            <div class="card__body">
              <span class="card__num">Beispiel, fiktiv</span>
              <h3><a href={`/wissen/situation/${c.situation}`}>{c.name}</a></h3>
              <p class="cases__line">{c.line}</p>
              <p>{c.shapes}</p>
              <p class="cases__first"><strong>Erster Schritt:</strong> {c.first}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .quick {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }
  .quick__title {
    font-size: 1.0625rem;
    margin-bottom: 0.9rem;
  }
  .card__media--list {
    padding: 1.25rem 1.35rem;
    display: flex;
    align-items: flex-start;
  }
  @media (min-width: 900px) {
    .cards--ways {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card__media--list ol {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--brand);
    display: grid;
    gap: 0.45rem;
  }
  .card__media--list .mono {
    color: var(--accent);
    margin-right: 0.35rem;
  }
  .running {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .running__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .running__item:last-child {
    border-bottom: 0;
  }
  .running__item a {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .running__item a:hover {
    color: var(--accent);
  }
  .running__where {
    color: var(--ink-soft);
    grid-column: 2;
  }
  .running__item .mono {
    grid-column: 2;
  }
  @media (min-width: 900px) {
    .running__item {
      grid-template-columns: 9rem 1fr 12rem 9rem 9rem;
    }
    .running__where,
    .running__item .mono {
      grid-column: auto;
    }
  }
  .running__note {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }
  .cases {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .cases__line {
    color: var(--ink) !important;
  }
  .cases__first {
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
    margin-top: auto !important;
  }
  .states-aside {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .states-aside h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .states-aside .state-list li {
    color: var(--on-brand-soft);
  }
</style>
