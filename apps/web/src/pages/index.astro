---
// Startseite nach inhaltskonzept.md 3 und designsystem.md 2.1: Aufmacher mit Foto und
// Lebenssituationen und Schnelleinstiegen (die Suche steht im Kopf), die drei Wege,
// die vier Schlüssel, Aktuelles, Beispielwege. Texte aus dem Katalog der Sprache (ui.home.*), Pfade mit Sprachpräfix.
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { RUBRICS, rubricText } from "../lib/rubrics.ts";
import { SITUATIONS, situationText } from "../lib/situations.ts";
import { CASES, caseText } from "../lib/cases.ts";
import { loadNews, newsPath, newsImage } from "../lib/news.ts";
import { loadPages, pagePath } from "../lib/pages.ts";
import { CONTENT_DIR, fmtDate, pageContext } from "../lib/page.ts";
import hero from "../assets/hero-dokumente.webp";
import ort from "../assets/ort-hauptplatz.webp";

const { lang, texts, u, p } = pageContext(Astro);
const heroImg = await getImage({ src: hero, width: 960, format: "webp", quality: 62 });
const pages = loadPages(CONTENT_DIR, lang);
const byId = new Map(pages.map((x) => [x.id, x]));
// Schnelleinstiege: Themenseiten, in der Sprache oder als deutsche Fassung.
const chips = ["oib", "staatsangehoerigkeit-abstammung", "bescheinigung-auswanderer", "wohnsitz-anmelden", "krankenversicherung", "lohnsteuerbefreiung", "biram-hrvatsku", "schule-und-zeugnisse", "fuehrerschein-umschreiben"]
  .map((id) => byId.get(id))
  .filter((x): x is NonNullable<typeof x> => !!x);
// Aktuelles: die drei neuesten Meldungen.
const news = loadNews(CONTENT_DIR, lang).slice(0, 3);
// Die vier Schlüssel (inhaltskonzept.md 1.1) mit ihrer Zielseite: Rubrik für den Status,
// sonst die Themenseite, sofern sie existiert.
const topicHref = (id: string) => { const x = byId.get(id); return x ? p(pagePath(x)) : undefined; };
const keys = [
  { title: u("home.key1_title"), sub: u("home.key1_sub"), hr: false, text: u("home.key1_text"), href: p("/wissen/status-und-staatsangehoerigkeit") },
  { title: u("home.key2_title"), sub: "osobni identifikacijski broj", hr: true, text: u("home.key2_text"), href: topicHref("oib") },
  { title: u("home.key3_title"), sub: "prijava prebivališta", hr: true, text: u("home.key3_text"), href: topicHref("wohnsitz-anmelden") },
  { title: u("home.key4_title"), sub: "zdravstveno osiguranje", hr: true, text: u("home.key4_text"), href: topicHref("krankenversicherung") },
];
---

<Base title={u("home.title")} description={u("home.description")} current="start" preload={heroImg.src}>
  <section class="hero hero--full">
    <div class="container">
      <div class="hero__screen">
      <div class="hero__text">
        <h1>{u("home.hero_title")}</h1>
        <p class="lede">{u("home.hero_lede")}</p>
      </div>
      <nav class="hero__situations" aria-label={u("home.situations_title")}>
        <h2>{u("home.situations_title")}</h2>
        <ul>
          {SITUATIONS.map((x) => <li><a href={p(`/wissen/situation/${x.slug}`)}>{situationText(x, texts).title}</a></li>)}
        </ul>
      </nav>
      </div>
      {/* Schmal zugeklappt (details ohne open), breit immer offen; das Skript unten setzt
          das Attribut nach Bildschirmbreite. Ohne JavaScript bleibt alles offen. */}
      <details class="hero__situations hero__quick" open>
        <summary><h2>{u("home.quick_title")}</h2></summary>
        <nav aria-label={u("home.quick_title")}>
          <ul>
            {chips.map((x) => <li><a href={p(pagePath(x))}>{x.title}</a></li>)}
          </ul>
        </nav>
      </details>
      <div class="hero__media">
        <Image src={hero} alt={u("home.hero_alt")} widths={[640, 960]} sizes="(min-width: 860px) 50vw, 100vw" format="webp" quality={62} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>
  <script is:inline>
    // «Häufig gesucht» ist auf schmalen Bildschirmen zugeklappt, auf breiten offen.
    (function () {
      var box = document.querySelector(".hero__quick");
      var narrow = window.matchMedia("(max-width: 720px)");
      function apply() { box.open = !narrow.matches; }
      apply();
      narrow.addEventListener("change", apply);
    })();
  </script>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>{u("home.ways_title")}</h2>
      </div>
      <ul class="cards cards--ways">
        <li class="card card--link">
          <div class="card__media">
            <Image src={hero} alt="" width={640} height={427} format="webp" loading="lazy" />
          </div>
          <div class="card__body">
            <h3><a href={p("/mein-weg")}>{u("home.way_check_title")}</a></h3>
            <p>{u("home.way_check_text")}</p>
            <span class="arrow-link">{u("shell.cta")}</span>
          </div>
        </li>
        <li class="card card--link">
          <div class="card__media card__media--list" aria-hidden="true">
            <ol>
              {RUBRICS.slice(0, 5).map((r) => <li><span class="mono">{r.number}</span> {rubricText(r, texts).title}</li>)}
            </ol>
          </div>
          <div class="card__body">
            <h3><a href={p("/wissen")}>{u("home.way_wissen_title")}</a></h3>
            <p>{u("home.way_wissen_text")}</p>
            <span class="arrow-link">{u("home.way_wissen_link")}</span>
          </div>
        </li>
        <li class="card card--link">
          <div class="card__media">
            <Image src={ort} alt="" width={640} height={427} format="webp" loading="lazy" />
          </div>
          <div class="card__body">
            <h3><a href={p("/orte")}>{u("home.way_orte_title")}</a></h3>
            <p>{u("home.way_orte_text")}</p>
            <span class="arrow-link">{u("home.way_orte_link")}</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band--brand">
    <div class="container">
      <div class="band__head">
        <h2>{u("home.keys_title")}</h2>
      </div>
      <ol class="keys">
        {keys.map((k, i) => (
          <li class="key">
            <span class="key__num" aria-hidden="true">{i + 1}</span>
            <h3>{k.href ? <a href={k.href}>{k.title}</a> : k.title}</h3>
            <span class="key__hr" lang={k.hr ? "hr" : undefined}>{k.sub}</span>
            <p>{k.text}</p>
            {k.href && <a class="arrow-link" href={k.href}>{u("home.key_link")}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>{u("home.news_title")}</h2>
      </div>
      <ul class="cards news">
        {news.map((n) => (
          <li class="card card--link">
            <div class="card__media">
              <Image src={newsImage(n)!} alt={n.news.image.alt} width={640} height={427} format="webp" loading="lazy" />
            </div>
            <div class="card__body">
              <span class="news__date">{fmtDate(n.news.published_on)}{n.synthetic && <span class="news__example">{u("news.example")}</span>}</span>
              <h3><a href={p(newsPath(n))}>{n.title}</a></h3>
              <p>{n.short_answer}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="news__more"><a class="arrow-link" href={p("/aktuell")}>{u("home.news_all")}</a></p>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <div class="band__head">
        <h2>{u("home.cases_title")}</h2>
      </div>
      <ul class="cards cases">
        {CASES.map((raw) => {
          const c = caseText(raw, texts);
          return (
            <li class="card card--link cases__card">
              <div class="card__body">
                <h3><a href={p(`/wissen/situation/${c.situation}`)}>{c.name}</a></h3>
                <span class="cases__meta">{u("home.cases_meta", { age: c.age, place: c.place })}</span>
                <dl class="cases__facts">
                  <dt>{u("home.cases_situation")}</dt>
                  <dd>{c.line}</dd>
                  <dt>{u("home.cases_shapes")}</dt>
                  <dd>{c.shapes}</dd>
                </dl>
                <div class="cases__first">
                  <span class="cases__label">{u("home.cases_first")}</span>
                  <p>{c.first}</p>
                </div>
                <span class="cases__example">{u("home.cases_label")}</span>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>

<style>
  .news {
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .news {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .news__date {
    font-family: var(--font-meta);
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .news__example {
    color: var(--st-unknown);
  }
  .news__more {
    margin: 1.25rem 0 0;
  }
  @media (min-width: 900px) {
    .cards--ways {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Beispielwege: Name gross, Alter und Ort darunter, dann Ausgangslage und Prägung als
     beschriftete Absätze, der erste Schritt als hervorgehobener Block unten. */
  .cases {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .cases__card .card__body {
    gap: 0;
  }
  .cases__card h3 {
    font-size: 1.5rem;
  }
  .cases__meta {
    font-family: var(--font-meta);
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 0.15rem 0 1.1rem;
  }
  .cases__facts {
    margin: 0;
  }
  .cases__facts dt,
  .cases__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .cases__facts dd {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .cases__first {
    margin-top: auto;
    background: var(--surface-blue);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
  }
  .cases__first .cases__label {
    color: var(--accent-deep);
    display: block;
  }
  .cases__first p {
    margin: 0;
    color: var(--ink);
    font-size: 0.9375rem;
  }
  .cases__example {
    font-family: var(--font-meta);
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 0.85rem;
  }
</style>
