---
import Base from "../layouts/Base.astro";
import { pageContext } from "../lib/page.ts";

const { u, p } = pageContext(Astro);
---

<Base title={`${u("notfound.title")}: povratnik.com`} description={u("notfound.text")}>
  <section class="band">
    <div class="container grid">
      <div class="col-main">
        <h1>{u("notfound.title")}</h1>
        <p>{u("notfound.text")}</p>
        <p><a class="button button--primary" href={p("/")}>{u("notfound.home")}</a></p>
      </div>
    </div>
  </section>
</Base>
