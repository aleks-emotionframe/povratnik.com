---
// Orte entdecken (inhaltskonzept.md 5): Liste mit Filtern, vollwertig ohne JavaScript
// (die Liste ist serverseitig gerendert, der Filter blendet nur aus). Auf der Teststufe
// fiktive Testgemeinden (ADR-0004), die Karte folgt mit der Datenbank (M5).
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { loadPlaces, placeName, openBenefits } from "../../lib/places.ts";
import { pageContext } from "../../lib/page.ts";
import ort from "../../assets/ort-hauptplatz.webp";

const { u, p } = pageContext(Astro);
const places = loadPlaces();
const targets = (pl: (typeof places)[number]) => {
  const t = new Set<string>();
  for (const b of pl.benefits) {
    const s = `${b.title} ${b.target}`.toLowerCase();
    if (/famil|kind|partner/.test(s)) t.add("families");
    if (/gewerbe|gründ|rückkehrer|auswanderer/.test(s)) t.add("returnees");
    if (/miet|wohn|bauland/.test(s)) t.add("housing");
  }
  return [...t].join(" ");
};
---

<Base title={`${u("orte.title")}: povratnik.com`} description={u("orte.description")} current="orte">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <h1>{u("orte.title")}</h1>
        <p class="lede">{u("orte.lede")}</p>
        <div class="hero__actions">
          <a class="button button--light" href={p("/orte/leistungen")}>{u("orte.all_benefits")}</a>
          <a class="button button--outline-light" href={p("/orte/vergleich")}>{u("orte.compare")}</a>
        </div>
      </div>
      <div class="hero__media">
        <Image src={ort} alt={u("orte.image_alt")} widths={[640, 960]} sizes="(min-width: 860px) 50vw, 100vw" format="webp" quality={62} loading="eager" />
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <p class="notice" role="note">
        <strong>{u("orte.fictional_title")}</strong>
        {u("orte.fictional_text")}
      </p>

      <form class="filters" id="filters" aria-label={u("orte.filter_label")}>
        <fieldset>
          <legend>{u("orte.filter_region")}</legend>
          <label><input type="radio" name="region" value="" checked /> {u("orte.filter_all")}</label>
          <label><input type="radio" name="region" value="coast" /> {u("orte.coast")}</label>
          <label><input type="radio" name="region" value="inland" /> {u("orte.inland")}</label>
        </fieldset>
        <fieldset>
          <legend>{u("orte.filter_target")}</legend>
          <label><input type="checkbox" name="target" value="families" /> {u("orte.target_families")}</label>
          <label><input type="checkbox" name="target" value="returnees" /> {u("orte.target_returnees")}</label>
          <label><input type="checkbox" name="target" value="housing" /> {u("orte.target_housing")}</label>
        </fieldset>
        <fieldset>
          <legend>{u("orte.filter_state")}</legend>
          <label><input type="checkbox" name="open" value="1" /> {u("orte.only_open")}</label>
        </fieldset>
        <noscript><p class="soft">{u("orte.no_js")}</p></noscript>
      </form>

      <p class="count mono" id="count" aria-live="polite" data-one={u("orte.count_one", { n: "{n}" })} data-many={u("orte.count_many", { n: "{n}" })}>{u("orte.count_many", { n: places.length })}</p>
      <ul class="cards cards--places" id="places">
        {places.map((pl) => (
          <li class="card card--link" data-region={pl.region} data-targets={targets(pl)} data-open={openBenefits(pl)}>
            <div class="card__body">
              <span class="card__num">{pl.county} · {u(pl.region === "coast" ? "orte.coast" : "orte.inland")}</span>
              <h3><a href={p(`/orte/${pl.id}`)}>{placeName(pl)}</a></h3>
              <p>{pl.summary}</p>
              <p class="card__facts">
                <span class={`state state--${openBenefits(pl) > 0 ? "matches" : "closed"}`}>{u(openBenefits(pl) === 1 ? "orte.open_one" : "orte.open_many", { n: openBenefits(pl) })}</span>
                <span class="state state--closed">{u("orte.more", { n: pl.benefits.length - openBenefits(pl) })}</span>
              </p>
              <div class="depth">
                <span>{u("orte.depth", { n: pl.data_depth.collected, total: pl.data_depth.total })}</span>
                <div class="depth__bar"><div class="depth__fill" style={`width:${Math.round((100 * pl.data_depth.collected) / pl.data_depth.total)}%`}></div></div>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="empty" id="empty" hidden>{u("orte.empty")}</p>
    </div>
  </section>

  <section class="band">
    <div class="container grid">
      <div class="col-main">
        <h2>{u("orte.ranking_title")}</h2>
        <p>{u("orte.ranking_text")}</p>
        <p><a class="arrow-link" href={p("/orte/vergleich")}>{u("orte.to_compare")}</a></p>
      </div>
      <aside class="col-aside">
        <div class="side--cta">
          <h3>{u("orte.municipality_title")}</h3>
          <p>{u("orte.municipality_text")}</p>
          <a class="button button--primary" href="mailto:kontakt@povratnik.com?subject=Gemeinde%20eintragen">{u("orte.municipality_cta")}</a>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    // Filter blendet Karten aus; ohne JavaScript bleibt die vollständige Liste stehen.
    (function () {
      var form = document.getElementById("filters");
      var cards = Array.prototype.slice.call(document.querySelectorAll("#places > li"));
      var count = document.getElementById("count");
      var empty = document.getElementById("empty");
      function apply() {
        var region = form.querySelector('input[name="region"]:checked').value;
        var targets = Array.prototype.map.call(form.querySelectorAll('input[name="target"]:checked'), function (i) { return i.value; });
        var open = form.querySelector('input[name="open"]').checked;
        var shown = 0;
        cards.forEach(function (c) {
          var ok = (!region || c.dataset.region === region) &&
            targets.every(function (t) { return (c.dataset.targets || "").split(" ").indexOf(t) !== -1; }) &&
            (!open || Number(c.dataset.open) > 0);
          c.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = (shown === 1 ? count.dataset.one : count.dataset.many).replace("{n}", shown);
        empty.hidden = shown > 0;
      }
      form.addEventListener("change", apply);
      form.addEventListener("submit", function (e) { e.preventDefault(); });
    })();
  </script>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.5rem 0 1rem;
  }
  .filters fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: center;
  }
  .filters legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0;
    margin-bottom: 0.35rem;
    float: left;
    width: 100%;
  }
  .filters label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.9375rem;
  }
  .filters input {
    accent-color: var(--accent);
    width: 1.1rem;
    height: 1.1rem;
  }
  .count {
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .cards--places {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .card__facts {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .cards--places .depth {
    margin-top: 0.5rem;
  }
  .empty {
    color: var(--ink-soft);
  }
  .side--cta {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .side--cta h3 {
    font-size: 1.0625rem;
  }
  .side--cta p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
