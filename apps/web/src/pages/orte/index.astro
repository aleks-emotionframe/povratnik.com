---
// Orte entdecken (inhaltskonzept.md 5): Liste mit Filtern, vollwertig ohne JavaScript
// (die Liste ist serverseitig gerendert, der Filter blendet nur aus). Auf der Teststufe
// fiktive Testgemeinden (ADR-0004). Die Karte ist der Aufmacher: Gespanschaften und Orte
// unter dem Zeiger erscheinen im Feld daneben, Klick führt zur Region oder zum Ort.
import Base from "../../layouts/Base.astro";
import MapHr from "../../components/MapHr.astro";
import { loadPlaces, placeName, openBenefits } from "../../lib/places.ts";
import { pageContext } from "../../lib/page.ts";
import { COUNTIES } from "../../lib/map.ts";

const { u, p } = pageContext(Astro);
const places = loadPlaces();
const dots = places.filter((pl) => pl.map).map((pl) => ({ id: pl.id, name: placeName(pl), lon: pl.map!.lon, lat: pl.map!.lat, href: p(`/orte/${pl.id}`), summary: pl.summary, open: openBenefits(pl), county: pl.county }));
const targets = (pl: (typeof places)[number]) => {
  const t = new Set<string>();
  for (const b of pl.benefits) {
    const s = `${b.title} ${b.target}`.toLowerCase();
    if (/famil|kind|partner/.test(s)) t.add("families");
    if (/gewerbe|gründ|rückkehrer|auswanderer/.test(s)) t.add("returnees");
    if (/miet|wohn|bauland/.test(s)) t.add("housing");
  }
  return [...t].join(" ");
};
---

<Base title={`${u("orte.title")}: povratnik.com`} description={u("orte.description")} current="orte">
  <section class="hero hero--map">
    <div class="container">
      <div class="hero__text">
        <h1>{u("orte.title")}</h1>
        <p class="lede">{u("orte.lede")}</p>
        <div class="map-info" id="map-info" aria-live="polite">
          <strong class="map-info__title" id="map-info-title" data-default={u("map.info_title")}>{u("map.info_title")}</strong>
          <p class="map-info__text" id="map-info-text" data-default={u("map.info_text", { counties: COUNTIES.length, places: dots.length })}>{u("map.info_text", { counties: COUNTIES.length, places: dots.length })}</p>
          <a class="arrow-link map-info__link" id="map-info-link" href="#" hidden data-region={u("map.info_region_link")} data-place={u("map.info_place_link")}></a>
        </div>
        <p class="hero__tools">
          <a href={p("/orte/leistungen")}>{u("orte.all_benefits")}</a>
          <a href={p("/orte/vergleich")}>{u("orte.compare")}</a>
        </p>
      </div>
      <div class="hero__map">
        <MapHr hero places={dots} />
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">

      <form class="filters" id="filters" aria-label={u("orte.filter_label")}>
        <fieldset>
          <legend>{u("orte.filter_region")}</legend>
          <label><input type="radio" name="region" value="" checked /> {u("orte.filter_all")}</label>
          <label><input type="radio" name="region" value="coast" /> {u("orte.coast")}</label>
          <label><input type="radio" name="region" value="inland" /> {u("orte.inland")}</label>
        </fieldset>
        <fieldset>
          <legend>{u("orte.filter_target")}</legend>
          <label><input type="checkbox" name="target" value="families" /> {u("orte.target_families")}</label>
          <label><input type="checkbox" name="target" value="returnees" /> {u("orte.target_returnees")}</label>
          <label><input type="checkbox" name="target" value="housing" /> {u("orte.target_housing")}</label>
        </fieldset>
        <fieldset>
          <legend>{u("orte.filter_state")}</legend>
          <label><input type="checkbox" name="open" value="1" /> {u("orte.only_open")}</label>
        </fieldset>
        <noscript><p class="soft">{u("orte.no_js")}</p></noscript>
      </form>

      <p class="fictional">{u("orte.fictional_line")}</p>
      <p class="count mono" id="count" aria-live="polite" data-one={u("orte.count_one", { n: "{n}" })} data-many={u("orte.count_many", { n: "{n}" })}>{u("orte.count_many", { n: places.length })}</p>
      <ul class="cards cards--places" id="places">
        {places.map((pl) => (
          <li class="card card--link" data-region={pl.region} data-targets={targets(pl)} data-open={openBenefits(pl)}>
            <div class="card__body">
              <h3><a href={p(`/orte/${pl.id}`)}>{placeName(pl)}</a></h3>
              <span class="card__num">{pl.county} · {u(pl.region === "coast" ? "orte.coast" : "orte.inland")}</span>
              <p>{pl.summary}</p>
              <p class="card__facts">
                <span class={`state state--${openBenefits(pl) > 0 ? "matches" : "closed"}`}>{u(openBenefits(pl) === 1 ? "orte.open_one" : "orte.open_many", { n: openBenefits(pl) })}</span>
                <span class="state state--closed">{u("orte.more", { n: pl.benefits.length - openBenefits(pl) })}</span>
              </p>
              <div class="depth">
                <span>{u("orte.depth", { n: pl.data_depth.collected, total: pl.data_depth.total })}</span>
                <div class="depth__bar"><div class="depth__fill" style={`width:${Math.round((100 * pl.data_depth.collected) / pl.data_depth.total)}%`}></div></div>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="empty" id="empty" hidden>{u("orte.empty")}</p>
    </div>
  </section>

  <section class="band">
    <div class="container grid">
      <div class="col-main">
        <h2>{u("orte.ranking_title")}</h2>
        <p>{u("orte.ranking_text")}</p>
        <p><a class="arrow-link" href={p("/orte/vergleich")}>{u("orte.to_compare")}</a></p>
      </div>
      <aside class="col-aside">
        <div class="side--cta">
          <h3>{u("orte.municipality_title")}</h3>
          <p>{u("orte.municipality_text")}</p>
          <a class="button button--primary" href="mailto:kontakt@povratnik.com?subject=Gemeinde%20eintragen">{u("orte.municipality_cta")}</a>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    // Feld neben der Karte: zeigt Gespanschaft oder Ort unter dem Zeiger. Ohne JavaScript
    // bleibt der Standardtext, Klicks auf der Karte führen ohnehin zur Seite.
    (function () {
      var title = document.getElementById("map-info-title");
      var text = document.getElementById("map-info-text");
      var link = document.getElementById("map-info-link");
      if (!title) return;
      function show(el, kind) {
        title.textContent = el.dataset.name;
        if (kind === "place") {
          text.textContent = el.dataset.county + ". " + (el.dataset.summary || "");
          link.textContent = link.dataset.place;
        } else {
          text.textContent = "";
          link.textContent = link.dataset.region;
        }
        link.href = el.getAttribute("href");
        link.hidden = false;
      }
      function reset() {
        title.textContent = title.dataset.default;
        text.textContent = text.dataset.default;
        link.hidden = true;
      }
      document.querySelectorAll(".map__county, .map__place").forEach(function (el) {
        var kind = el.classList.contains("map__place") ? "place" : "county";
        el.addEventListener("mouseenter", function () { show(el, kind); });
        el.addEventListener("focus", function () { show(el, kind); });
        el.addEventListener("mouseleave", reset);
        el.addEventListener("blur", reset);
      });
    })();
  </script>
  <script is:inline>
    // Filter blendet Karten aus; ohne JavaScript bleibt die vollständige Liste stehen.
    (function () {
      var form = document.getElementById("filters");
      var cards = Array.prototype.slice.call(document.querySelectorAll("#places > li"));
      var count = document.getElementById("count");
      var empty = document.getElementById("empty");
      function apply() {
        var region = form.querySelector('input[name="region"]:checked').value;
        var targets = Array.prototype.map.call(form.querySelectorAll('input[name="target"]:checked'), function (i) { return i.value; });
        var open = form.querySelector('input[name="open"]').checked;
        var shown = 0;
        cards.forEach(function (c) {
          var ok = (!region || c.dataset.region === region) &&
            targets.every(function (t) { return (c.dataset.targets || "").split(" ").indexOf(t) !== -1; }) &&
            (!open || Number(c.dataset.open) > 0);
          c.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = (shown === 1 ? count.dataset.one : count.dataset.many).replace("{n}", shown);
        empty.hidden = shown > 0;
      }
      form.addEventListener("change", apply);
      form.addEventListener("submit", function (e) { e.preventDefault(); });
    })();
  </script>
</Base>

<style>
  /* Aufmacher: Text links, grosse Karte rechts auf Nachtblau. */
  .hero--map .container {
    padding-inline: var(--gutter);
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .hero--map .hero__text {
    padding: 0;
  }
  @media (min-width: 860px) {
    .hero--map .container {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
    }
  }
  .hero__map {
    min-height: 0;
  }
  .map-info {
    margin-top: 1.75rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
    min-height: 7.5rem;
  }
  .map-info__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--on-brand);
  }
  .map-info__text {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    color: var(--on-brand-soft);
  }
  .map-info__link {
    margin-top: 0.6rem;
    color: var(--accent-bright);
  }
  .map-info__link[hidden] {
    display: none;
  }
  .hero__tools {
    margin: 1.25rem 0 0;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero__tools a {
    color: var(--on-brand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .hero__tools a:hover {
    text-decoration-color: currentColor;
  }
  /* Schmal gibt es keinen Zeiger: das Feld entfällt, Antippen führt direkt zur Seite. */
  @media (max-width: 859px) {
    .map-info {
      display: none;
    }
    .hero__tools {
      margin-top: 0.5rem;
    }
  }
  .fictional {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
  }
  /* Filter als Schaltergruppen: Auswahl gefüllt in Markenfarbe, sonst Umriss. Die
     echten Eingabefelder bleiben für Tastatur und Vorleser, nur unsichtbar. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1.25rem;
    padding: 1.1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .filters fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .filters legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--muted);
    padding: 0;
    margin-bottom: 0.45rem;
    float: left;
    width: 100%;
  }
  .filters label {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .filters label:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
  .filters label:has(input:checked) {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
  }
  .filters label:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .filters input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .count {
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .cards--places {
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .cards--places {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card__facts {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .cards--places .depth {
    margin-top: 0.5rem;
  }
  .empty {
    color: var(--ink-soft);
  }
  .side--cta {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
  }
  .side--cta h3 {
    font-size: 1.0625rem;
  }
  .side--cta p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
