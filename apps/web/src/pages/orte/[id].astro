---
// Ortsprofil (designsystem.md 3, Typ 5; inhaltskonzept.md 5.1): dieselben Abschnitte für
// jeden Ort, jeder Fachwert mit Zustand, jede Leistung mit Programmzustand, Antrags-
// zeitraum und Prüfdatum. Datentiefe als eigener Balken.
import Base from "../../layouts/Base.astro";
import Fact from "../../components/Fact.astro";
import { CHANGE_STATE, PROGRAM_STATE, REGION, formatDate, loadPlaces, placeName, type Place } from "../../lib/places.ts";

export function getStaticPaths() {
  return loadPlaces().map((place) => ({ params: { id: place.id }, props: { place } }));
}

const { place } = Astro.props as { place: Place };
const depth = Math.round((100 * place.data_depth.collected) / place.data_depth.total);
const period = (b: Place["benefits"][number]) =>
  b.application.from || b.application.until
    ? `${b.application.from ? formatDate(b.application.from) : "offen"} bis ${b.application.until ? formatDate(b.application.until) : "laufend"}`
    : "Antragszeitraum unbekannt";
---

<Base title={`${placeName(place)}: Ortsprofil`} description={place.summary} current="orte">
  <section class="hero hero--small">
    <div class="container">
      <div class="hero__text">
        <p class="crumbs"><a href="/orte">Orte</a> / {place.county}</p>
        <h1>{placeName(place)}</h1>
        <p class="lede">{place.summary}</p>
        <div class="depth">
          <span>Datentiefe {place.data_depth.collected} von {place.data_depth.total} Angaben erfasst</span>
          <div class="depth__bar"><div class="depth__fill" style={`width:${depth}%`}></div></div>
        </div>
      </div>
      <div class="hero__media hero__media--plain">
        <dl class="glance">
          <dt>Lage</dt><dd>{REGION[place.region]}, {place.county}</dd>
          <dt>Einwohner</dt><dd><Fact fact={place.population} /></dd>
          <dt>Entwicklungsindex</dt><dd><Fact fact={place.development_index} /></dd>
          <dt>Ankommen</dt><dd><Fact fact={place.arrival.office} /></dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="container">
      <p class="notice" role="note">
        <strong>Fiktive Testgemeinde</strong>
        Dieser Ort ist erfunden. Er zeigt die Struktur eines Ortsprofils mit allen Zuständen. Kein Wert bezieht sich auf einen realen Ort.
      </p>
      <div class="band__head">
        <h2>Leistungen der Gemeinde</h2>
        <p class="soft">Vier Zeitangaben, ein Zustand. Über den Antrag entscheidet die Gemeinde.</p>
      </div>
      {place.benefits.length === 0 ? (
        <p><span class="state state--unknown">nicht erhoben</span> Für diesen Ort sind keine Leistungen erfasst. Das heisst nicht, dass es keine gibt.</p>
      ) : (
        <ul class="cards cards--benefits">
          {place.benefits.map((b) => (
            <li class="card">
              <div class="card__body">
                <p class="benefit__state"><span class={`state state--${PROGRAM_STATE[b.program_state].css}`}>{PROGRAM_STATE[b.program_state].label}</span></p>
                <h3>{b.title}</h3>
                <dl class="benefit">
                  <dt>Für wen</dt><dd>{b.target}</dd>
                  <dt>Betrag</dt><dd><Fact fact={b.amount} /></dd>
                  <dt>Bedingungen</dt><dd>{b.conditions.length ? <ul class="plain">{b.conditions.map((c) => <li>{c}</li>)}</ul> : <span class="state state--unknown">unbekannt</span>}</dd>
                  <dt>Antragszeitraum</dt><dd class="mono">{period(b)}</dd>
                  <dt>Budget</dt><dd><Fact fact={b.budget} /></dd>
                  <dt>Bindung</dt><dd>{b.binding}</dd>
                </dl>
                <p class="datenstand"><span>Quelle: {b.source}</span><span>Geprüft {formatDate(b.checked)}</span></p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="band">
    <div class="container grid">
      <div class="col-main profile">
        <h2>Familie und Bildung</h2>
        <dl class="open-field">
          <dt>Kindergarten</dt><dd><Fact fact={place.family_education.kindergarten} /></dd>
          <dt>Freie Plätze</dt><dd><Fact fact={place.family_education.kindergarten_capacity} /></dd>
          <dt>Grundschule</dt><dd><Fact fact={place.family_education.primary_school} /></dd>
          <dt>Weiterführend</dt><dd><Fact fact={place.family_education.secondary_school} /></dd>
          <dt>Sprachförderung</dt><dd><Fact fact={place.family_education.language_support} /></dd>
          <dt>Kosten</dt><dd><Fact fact={place.family_education.costs} /></dd>
        </dl>

        <h2>Gesundheit</h2>
        <dl class="open-field">
          <dt>Hausarzt</dt><dd><Fact fact={place.health.gp} /></dd>
          <dt>Nimmt neue Patienten</dt><dd><Fact fact={place.health.gp_accepting} /></dd>
          <dt>Kinderarzt</dt><dd><Fact fact={place.health.pediatrician} /></dd>
          <dt>Apotheke</dt><dd><Fact fact={place.health.pharmacy} /></dd>
          <dt>Nächstes Spital</dt><dd><Fact fact={place.health.clinic} /></dd>
        </dl>

        <h2>Wohnen</h2>
        <dl class="open-field">
          <dt>Jahresmieten</dt><dd><Fact fact={place.housing.long_term_rent} /></dd>
          <dt>Preisniveau</dt><dd><Fact fact={place.housing.price_level} /></dd>
          <dt>Gemeindewohnungen</dt><dd><Fact fact={place.housing.municipal_housing} /></dd>
          <dt>Bauland</dt><dd><Fact fact={place.housing.building_land} /></dd>
        </dl>

        <h2>Arbeit</h2>
        <dl class="open-field">
          <dt>Branchen</dt><dd>{place.work.sectors.join(", ")}</dd>
          <dt>Pendeln</dt><dd>{place.work.commute.map((c) => `${c.to} ${c.minutes} Minuten`).join(", ")} <span class="fact__note">Fahrzeit, keine Luftlinie</span></dd>
          <dt>Arbeitgeber</dt><dd><Fact fact={place.work.employers} /></dd>
        </dl>

        <h2>Alltag und Anschluss</h2>
        <dl class="open-field">
          <dt>Internet</dt><dd><Fact fact={place.daily.internet} /></dd>
          <dt>Öffentlicher Verkehr</dt><dd><Fact fact={place.daily.transport} /></dd>
          <dt>Sprachkurse</dt><dd><Fact fact={place.daily.language_courses} /></dd>
          <dt>Vereine</dt><dd>{place.daily.clubs.length ? place.daily.clubs.join(", ") : <span class="state state--closed">nicht erhoben</span>}</dd>
          <dt>Kirche</dt><dd><Fact fact={place.daily.church} /></dd>
          <dt>Einkauf</dt><dd><Fact fact={place.daily.shopping} /></dd>
        </dl>

        <h2>Erreichbares Umfeld</h2>
        {place.surroundings.length === 0 ? (
          <p><span class="state state--closed">nicht erhoben</span></p>
        ) : (
          <ul class="topics">
            {place.surroundings.map((s) => <li><span>{s.what}</span><span class="mono">{s.where}, {s.minutes} Minuten</span></li>)}
          </ul>
        )}
      </div>

      <aside class="col-aside">
        <div class="side">
          <h3>Ankommen</h3>
          <dl class="side__dl">
            <dt>Stelle</dt><dd><Fact fact={place.arrival.office} /></dd>
            <dt>Funktion</dt><dd>{place.arrival.function}</dd>
            <dt>Sprachen</dt><dd>{place.arrival.languages.length ? place.arrival.languages.join(", ") : <span class="state state--unknown">unbekannt</span>}</dd>
            <dt>Antwortweg</dt><dd>{place.arrival.channel}</dd>
          </dl>
        </div>
        <div class="side">
          <h3>Veränderungen</h3>
          {place.changes.length === 0 ? (
            <p><span class="state state--closed">nicht erhoben</span></p>
          ) : (
            <ul class="changes">
              {place.changes.map((c) => <li><span class={`state state--${c.state === "operating" ? "matches" : c.state === "announced" ? "announced" : "closed"}`}>{CHANGE_STATE[c.state]}</span> {c.title} <span class="mono muted">{formatDate(c.as_of)}</span></li>)}
            </ul>
          )}
          <p class="fact__note">Eine Ankündigung ist kein Zustand. Erst «in Betrieb» zählt.</p>
        </div>
        <div class="side side--cta">
          <h3>Passt dieser Ort zu meinem Weg?</h3>
          <p>Der Kurzcheck zeigt, welche Leistungen nach Ihren Angaben infrage kommen.</p>
          <a class="button button--primary" href="/mein-weg">Kurzcheck starten</a>
          <a class="arrow-link" href="/orte/vergleich">Mit anderen Orten vergleichen</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: 0.875rem;
    color: var(--on-brand-soft);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--on-brand);
  }
  .hero .depth {
    margin-top: 1.25rem;
    max-width: 28rem;
  }
  .hero__media--plain {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    min-height: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (min-width: 860px) {
    .hero__media--plain {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
  .glance {
    margin: 0;
    display: grid;
    gap: 0.35rem 1.25rem;
    grid-template-columns: max-content 1fr;
    max-width: none;
    font-size: 0.9375rem;
  }
  .glance dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--on-brand-soft);
    padding-top: 0.15rem;
  }
  .glance dd {
    margin: 0 0 0.6rem;
    color: var(--on-brand);
  }
  .glance .state {
    background: rgba(255, 255, 255, 0.12);
    color: var(--on-brand-soft);
  }
  .cards--benefits {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
  }
  .benefit__state {
    margin: 0;
  }
  .benefit {
    margin: 0.5rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem 1rem;
    font-size: 0.9375rem;
  }
  @media (min-width: 480px) {
    .benefit {
      grid-template-columns: minmax(7rem, 9rem) 1fr;
    }
  }
  .benefit dt {
    color: var(--muted);
  }
  .benefit dd {
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plain li::before {
    content: "· ";
    color: var(--accent);
  }
  .card .datenstand {
    margin-top: 0.75rem;
  }
  .profile h2 {
    font-size: 1.375rem;
    margin-top: 2rem;
  }
  .profile h2:first-child {
    margin-top: 0;
  }
  .profile .open-field {
    max-width: none;
    align-items: start;
  }
  .fact__note {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .side {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .side h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .side__dl {
    margin: 0;
    font-size: 0.9375rem;
  }
  .side__dl dt {
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .side__dl dd {
    margin: 0;
  }
  .changes {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }
  .side--cta {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.35rem;
    border-bottom: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .side--cta p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
