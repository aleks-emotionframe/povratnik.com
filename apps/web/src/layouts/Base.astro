---
// Grundlayout jeder Seite. Ohne JavaScript vollständig lesbar (CLAUDE.md 2.6).
// Kopf nach designsystem.md 2.1: Logo, Hauptnavigation, Suchfeld (schmal ein Link zur
// Suchseite), Sprachwahl als Kürzel (schmal als Klappe), hervorgehobener Kurzcheck.
// Schmal wie eine App: schlanke Kopfzeile, Tab-Leiste unten mit Start, Wissen, Orte, Mein Weg. Die Teststufe (ADR-0004) steht im Fuss jeder Seite.
// Im Fuss dasselbe Logo, per CSS weiss. Sprache aus
// der Adresse (lib/i18n.ts). Der EmotionFrame Footer steht als letztes Element.
import "../styles/base.css";
import { Image } from "astro:assets";
import logo from "../assets/povratnik-logo.webp";
import { STAGE } from "../lib/stage.ts";
import { LOCALES, LOCALE_NAMES, localePath } from "../lib/i18n.ts";
import { pageContext } from "../lib/page.ts";

interface Props {
  title: string;
  description: string;
  /** Aktueller Navigationspunkt für aria-current. */
  current?: "start" | "wissen" | "orte" | "mein-weg" | "ueber-uns" | "suche";
  /** Aufmacherbild vorladen (LCP). */
  preload?: string;
  /** Die Seite existiert in dieser Sprache nur als deutsche Fassung. */
  fallback?: boolean;
}
const { title, description, current, preload, fallback } = Astro.props;
const { lang, u, p } = pageContext(Astro);
const nav = [
  { href: p("/"), label: u("shell.nav_start"), key: "start" },
  { href: p("/wissen"), label: u("shell.nav_wissen"), key: "wissen" },
  { href: p("/orte"), label: u("shell.nav_orte"), key: "orte" },
  { href: p("/mein-weg"), label: u("shell.nav_weg"), key: "mein-weg" },
  { href: p("/ueber-uns"), label: u("shell.nav_about"), key: "ueber-uns" },
];
// Pfad ohne Sprachpräfix, für die Sprachwahl und hreflang.
const bare = Astro.url.pathname.replace(/^\/(hr|en|es)(?=\/|$)/, "") || "/";
---

<!doctype html>
<html lang={lang} data-stage={STAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#14213d" />
    {/* Teststufe (ADR-0004): nicht indexieren, bis die erste freigegebene Regel da ist. */}
    {STAGE === "test" && <meta name="robots" content="noindex, nofollow" />}
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={localePath(l, bare)} />)}
    <link rel="alternate" hreflang="x-default" href={bare} />
    <link rel="preload" href="/fonts/montserrat-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" href={preload} as="image" />}
    <link rel="stylesheet" href="/ef-signature/ef-signature.css" />
    <script src="/ef-signature/ef-signature.js" defer is:inline></script>
  </head>
  <body>
    <a class="skip" href="#inhalt">{u("shell.skip")}</a>
    <header class="site-head">
      <div class="container">
        <a class="brand" href={p("/")} aria-label="povratnik.com">
          <Image src={logo} alt="" height={34} densities={[1, 2]} format="webp" loading="eager" />
        </a>
        <nav class="site-nav" aria-label="Navigation">
          {nav.map((n) => <a href={n.href} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
        </nav>
        {/* Breit: nur die Lupe; ein Klick darauf (Beschriftung des Felds) öffnet das Feld,
            Enter sucht. Ohne Fokus klappt es wieder zu. */}
        <form class="head-search" role="search" action={p("/suche")} method="get" data-search>
          <label class="head-search__open" for="head-q" aria-label={u("shell.nav_search")}>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </label>
          <input id="head-q" type="search" placeholder={u("shell.nav_search")} autocomplete="off" aria-controls="head-results" />
          <button class="visually-hidden" type="submit">{u("search.button")}</button>
          <div class="head-search__results" id="head-results" hidden data-all={u("search.all")} data-none={u("search.none")} data-lang={lang} data-index="/suche-index.json"></div>
        </form>
        <a class="head-search-link" href={p("/suche")} aria-label={u("shell.nav_search")}>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </a>
        <nav class="lang" aria-label={u("shell.language")}>
          {LOCALES.map((l) => (
            <a href={localePath(l, bare)} lang={l} hreflang={l} aria-label={LOCALE_NAMES[l]} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
        {/* Schmal: die Sprachwahl als Klappe mit dem aktuellen Kürzel (details, ohne JavaScript). */}
        <details class="lang-menu">
          <summary aria-label={u("shell.language")}>{lang.toUpperCase()}</summary>
          <ul>
            {LOCALES.map((l) => (
              <li><a href={localePath(l, bare)} lang={l} hreflang={l} aria-current={l === lang ? "true" : undefined}>{LOCALE_NAMES[l]}</a></li>
            ))}
          </ul>
        </details>
        <a class="button button--primary" href={p("/mein-weg")}>{u("shell.cta")}</a>
      </div>
    </header>

    <script is:inline>
      // Kopfsuche: Ergebnisse erscheinen beim Tippen. Der Index ist eine statische Datei und
      // wird beim ersten Fokus geladen; der Suchbegriff bleibt im Browser (CLAUDE.md 2.5).
      // Enter führt zur Suchseite, der Begriff reist nur als Fragment. Ohne JavaScript
      // öffnet Enter die Suchseite leer.
      (function () {
        var form = document.querySelector("[data-search]");
        var input = form.querySelector("input");
        var box = document.getElementById("head-results");
        var index = null;
        function norm(s) { return s.toLowerCase().normalize("NFD").replace(/\p{M}/gu, ""); }
        function esc(s) { return s.replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
        function load() {
          if (index) return;
          index = [];
          fetch(box.dataset.index).then(function (r) { return r.json(); }).then(function (all) { index = all[box.dataset.lang] || []; render(); });
        }
        function render() {
          var q = norm(input.value.trim());
          if (!q) { box.hidden = true; box.innerHTML = ""; return; }
          var words = q.split(/\s+/);
          var hits = index.filter(function (e) {
            var hay = norm(e.title + " " + e.text + " " + (e.terms || ""));
            return words.every(function (w) { return hay.indexOf(w) !== -1; });
          });
          var inTitle = function (e) { return norm(e.title).indexOf(words[0]) !== -1 ? 1 : 0; };
          hits.sort(function (a, b) { return inTitle(b) - inTitle(a); });
          var html = hits.slice(0, 7).map(function (e) {
            return '<a href="' + esc(e.href) + '"><span class="head-search__kind">' + esc(e.kind) + "</span>" + esc(e.title) + "</a>";
          }).join("");
          if (!hits.length) html = "<p>" + esc(box.dataset.none) + "</p>";
          html += '<a class="head-search__all" href="' + esc(form.getAttribute("action")) + "#q=" + encodeURIComponent(input.value.trim()) + '">' + esc(box.dataset.all) + " (" + hits.length + ")</a>";
          box.innerHTML = html;
          box.hidden = false;
        }
        input.addEventListener("focus", load);
        input.addEventListener("input", render);
        document.addEventListener("click", function (e) { if (!form.contains(e.target)) box.hidden = true; });
        input.addEventListener("keydown", function (e) { if (e.key === "Escape") { box.hidden = true; input.blur(); } });
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var q = input.value.trim();
          var local = document.getElementById("q");
          if (local) {
            local.value = q;
            local.dispatchEvent(new Event("input"));
            local.focus();
            box.hidden = true;
            return;
          }
          location.href = form.getAttribute("action") + (q ? "#q=" + encodeURIComponent(q) : "");
        });
      })();
    </script>

    <main id="inhalt">
      {fallback && (
        <div class="container">
          <p class="notice notice--fallback" role="note">
            <strong>{u("shell.working_copy_title")}</strong>
            {u("shell.working_copy_text")}
          </p>
        </div>
      )}
      <slot />
    </main>

    <footer class="site-foot">
      <div class="container">
        <div>
          <a class="brand brand--on-dark" href={p("/")} aria-label="povratnik.com">
            <Image src={logo} alt="" height={30} densities={[1, 2]} format="webp" loading="lazy" />
          </a>
          <p>{u("shell.foot_claim")}</p>
          <p>{u("shell.foot_disclaimer")}</p>
          {STAGE === "test" && <p class="datenstand">{u("shell.foot_stage")}</p>}
        </div>
        <div>
          <h3>{u("shell.foot_wissen")}</h3>
          <ul>
            <li><a href={p("/wissen")}>{u("shell.foot_all")}</a></li>
            <li><a href={p("/wissen/glossar")}>{u("shell.foot_glossary")}</a></li>
            <li><a href={p("/aktuell")}>{u("news.crumb")}</a></li>
            <li><a href={p("/zahlen")}>{u("shell.foot_figures")}</a></li>
            <li><a href={p("/anlaufstellen")}>{u("shell.foot_contacts")}</a></li>
          </ul>
        </div>
        <div>
          <h3>{u("shell.foot_tools")}</h3>
          <ul>
            <li><a href={p("/mein-weg")}>{u("shell.foot_check")}</a></li>
            <li><a href={p("/orte")}>{u("shell.foot_places")}</a></li>
            <li><a href={p("/orte/leistungen")}>{u("shell.foot_benefits")}</a></li>
            <li><a href={p("/suche")}>{u("shell.foot_search")}</a></li>
          </ul>
        </div>
        <div>
          <h3>{u("shell.foot_about")}</h3>
          <ul>
            <li><a href={p("/ueber-uns")}>{u("shell.foot_mission")}</a></li>
            <li><a href={p("/ueber-uns#grundsaetze")}>{u("shell.foot_principles")}</a></li>
            <li><a href="mailto:kontakt@povratnik.com">{u("shell.foot_contact")}</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <div class="ef-sig" data-ef-v="2.3">
      <div class="ef-sig__inner">
        <div class="ef-sig__row">
          <p class="ef-sig__copy">
            &copy; <span class="ef-sig__year">2026</span> povratnik.com. Alle Rechte vorbehalten.
          </p>
          <a class="ef-sig__by" href="https://emotionframe.ch/webdesign" target="_blank" rel="noopener">
            <span class="ef-sig__by-label">Umsetzung</span>
            <img
              class="ef-sig__logo"
              src="/ef-signature/ef-logo-on-dark.webp"
              alt="EmotionFrame"
              width="64"
              height="16"
              loading="lazy"
              decoding="async"
            />
          </a>
          <nav class="ef-sig__legal" aria-label="Rechtliches">
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
            <a href="/agb">AGB</a>
          </nav>
        </div>
      </div>
    </div>
    {/* Schmal: Tab-Leiste unten wie in einer App; breit ausgeblendet. */}
    <nav class="tabbar" aria-label="Navigation">
      <a href={p("/")} aria-current={current === "start" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span>{u("shell.nav_start")}</span>
      </a>
      <a href={p("/wissen")} aria-current={current === "wissen" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h6.5a2 2 0 0 1 2 2V19a2 2 0 0 0-2-2H4zM20 5.5h-6.5a2 2 0 0 0-2 2V19a2 2 0 0 1 2-2H20z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span>{u("shell.nav_wissen")}</span>
      </a>
      <a href={p("/orte")} aria-current={current === "orte" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
        <span>{u("shell.nav_orte")}</span>
      </a>
      <a href={p("/mein-weg")} aria-current={current === "mein-weg" ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18c4 0 4-12 8-12s4 12 8 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="4" cy="18" r="2" fill="currentColor" /><circle cx="20" cy="18" r="2" fill="currentColor" /></svg>
        <span>{u("shell.nav_weg")}</span>
      </a>
    </nav>
  </body>
</html>
